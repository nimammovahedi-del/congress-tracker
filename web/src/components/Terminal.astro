---
// A log that types itself out, one line after another, ending on a blinking cursor. It types
// only on the first page of a visit; later pages (html.calm) show it straight away.
export interface Line {
  text: string;
  tone?: "dim" | "bright" | "ok" | "alert";
  href?: string;
}
interface Props {
  lines: Line[];
  delay?: number; // ms before the first line
}
const { lines, delay = 300 } = Astro.props;
---

<ol class="term" style={`--d:${delay}ms`}>
  {
    lines.map((l, k) => (
      <li class={l.tone ?? "dim"} style={`--k:${k};--len:${Math.min(l.text.length + 2, 90)}`}>
        <span>
          {">"} {l.href ? <a href={l.href}>{l.text}</a> : l.text}
        </span>
      </li>
    ))
  }
  <li class="bright" style={`--k:${lines.length};--len:2`}><span>{">"} <i class="block-cursor"></i></span></li>
</ol>

<style>
  .term {
    list-style: none;
    margin: 0;
    padding: var(--pad);
    font: 400 0.8rem/1.6 var(--mono);
    color: var(--faint);
  }
  li + li {
    margin-top: 4px;
  }
  /* Lines wrap rather than being cut off; the typing reveal is a stepped wipe, so a
     wrapped line types out without reflowing. */
  li span {
    display: inline-block;
    max-width: 100%;
    vertical-align: bottom;
  }
  .bright {
    color: var(--soft);
  }
  .ok {
    color: var(--ok);
  }
  .alert {
    color: var(--alert);
  }
  a:hover {
    text-decoration: underline;
  }
  :global(.fx) li span {
    animation: type 260ms steps(var(--len)) both;
    animation-delay: calc(var(--d) + var(--k) * 120ms);
  }
  :global(.fx.calm) li span {
    animation: none;
  }
  @keyframes type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.fx) li span {
      animation: none;
    }
  }
</style>
