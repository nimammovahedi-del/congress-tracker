---
// A topic as a photo card: a grayscale photo that turns to color when pointed at, with the
// name on a dark gradient so it stays readable over any photo. Photos live in
// public/topics/<slug>.jpg (public-domain, listed in web/topic-image-sources.md); a topic without
// one falls back to default.jpg.
import type { Topic } from "../lib/db";

interface Props {
  topic: Topic;
  laws?: boolean;
}
const { topic: t, laws = false } = Astro.props;
---

<a class="topic-card" href={`/topics/${t.slug}`}>
  <img src={`/topics/${t.slug}.jpg`} alt="" loading="lazy" decoding="async" width="800" height="500" onerror="this.onerror=null;this.src='/topics/default.jpg'" />
  <span class="topic-name">{t.area}</span>
  <span class="topic-n">{t.bills.toLocaleString("en-US")} bills{laws && t.laws > 0 && ` · ${t.laws} became law`}</span>
</a>

<style>
  .topic-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 4px;
    height: 100%;
    aspect-ratio: 16 / 10;
    padding: 16px;
    overflow: hidden;
    border: 1px solid var(--line-2);
    background: var(--panel-2);
    isolation: isolate;
  }
  .topic-card img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) brightness(0.8);
    transform: scale(1.01);
    transition:
      filter 260ms ease,
      transform 400ms var(--ease);
  }
  .topic-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(0 0 0 / 88%) 0%, rgb(0 0 0 / 45%) 50%, rgb(0 0 0 / 5%) 100%);
  }
  .topic-name {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    font-weight: 500;
    line-height: 1.2;
    color: #fff; /* always over a darkened photo, in either theme */
  }
  .topic-n {
    font: 400 var(--fs-sm) var(--mono);
    color: #d8d8d8;
  }
  .topic-card:hover,
  .topic-card:focus-visible {
    border-color: var(--soft);
  }
  .topic-card:hover img,
  .topic-card:focus-visible img {
    filter: grayscale(0) brightness(0.85);
    transform: scale(1.05);
  }
  @media (max-width: 520px) {
    .topic-card {
      aspect-ratio: 4 / 3;
      padding: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .topic-card img {
      transition: none;
    }
  }
</style>
