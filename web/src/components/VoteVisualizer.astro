---
// The vote visualizer: a seat chart (each dot a member: party color, filled = Yea,
// outline = Nay, faint = didn't vote) with a member inspector, and a member list with the
// tally analysis and a searchable list of every member's vote. The two views are tabs (see
// initTabs in fx.ts). Used on vote pages, where its heading is the page title, and embedded
// on bill pages, where the bill is already named above it.
import type { MemberVote, RollCall } from "../lib/db";
import { consoleDate, memberTag, partyClass, POSITION_LABELS, STATES } from "../lib/format";
import { hemicycle } from "../lib/hemicycle";
import { passed, ruleInfo, threshold, voteRef, type SeatInfo } from "../lib/votes";
import TallyBar from "./TallyBar.astro";
import Term from "./Term.astro";

interface Props {
  rollCall: RollCall;
  votes: MemberVote[];
  seats: Record<string, SeatInfo>;
  billTitle?: string | null;
  embedded?: boolean;
}
const { rollCall: r, votes, seats: seatData, billTitle, embedded = false } = Astro.props;

const PARTY_ORDER = ["D", "I", "R"];
const POSITION_ORDER = ["yea", "nay", "present", "not_voting", "other"];
const partyOf = (v: MemberVote) => (v.party === "D" || v.party === "R" ? v.party : "I");
const rank = (v: MemberVote) => {
  const pos = POSITION_ORDER.indexOf(v.position);
  return partyOf(v) === "R" ? -pos : pos; // members who broke ranks sit near the middle
};
const seated = [...votes].sort(
  (a, b) => PARTY_ORDER.indexOf(partyOf(a)) - PARTY_ORDER.indexOf(partyOf(b)) || rank(a) - rank(b) || (a.last_name ?? "").localeCompare(b.last_name ?? ""),
);
const { seats, dot } = hemicycle(seated.length);
const cls = (v: MemberVote) => `seat ${partyClass(partyOf(v))} ${v.position === "yea" ? "y" : v.position === "nay" ? "n" : "nv"}`;

const parties = PARTY_ORDER.map((p) => {
  const m = votes.filter((v) => partyOf(v) === p);
  return { p, total: m.length, yea: m.filter((v) => v.position === "yea").length, nay: m.filter((v) => v.position === "nay").length };
}).filter((x) => x.total > 0);

const t = threshold(r);
const ok = passed(r);
const registry = [...votes].sort((a, b) => (a.last_name ?? "").localeCompare(b.last_name ?? ""));
const heading = voteRef(r);
const PARTY_NAMES: Record<string, string> = { D: "Democrat", R: "Republican", I: "Independent" };
const chamberName = r.chamber === "senate" ? "Senate" : "House";
const diff = r.yea - r.nay;
const absent = votes.filter((v) => v.position !== "yea" && v.position !== "nay").length;
const UNITY_TIP = "On votes where most Democrats and most Republicans voted on opposite sides, how often this member voted with most of their own party.";
---

<div class="viz" data-viz data-tabs data-chamber={r.chamber}>
  {/* What the vote was and how it came out, above both views, so it stays put when the view
      changes. On vote pages it holds the page title; on bill pages the bill is named above. */}
  <header class="viz-head">
    <p class="label entry"><span class="sq-mini"></span> {chamberName} vote {r.roll_number}{!embedded && heading !== `${chamberName} vote ${r.roll_number}` && <> <span class="faint">·</span> {heading}</>} <span class="faint">·</span> {consoleDate(r.vote_date)}</p>
    {
      embedded ? (
        <p class="question-big">{r.question ?? "Recorded vote"}</p>
      ) : (
        <>
          {/* The title says what was voted on; the roll-call reference sits in the label above. */}
          <h1 class:list={["measure", (billTitle ?? r.question ?? heading).length > 40 && "long"]}>{billTitle ?? r.question ?? heading}</h1>
          {r.bill_id && <a class="bill-title" href={`/bills/${r.bill_id}`}>Open the bill <span aria-hidden="true">→</span></a>}
          <p class="question"><span class="label">The question</span> {r.question ?? "Recorded vote"}</p>
        </>
      )
    }
    {/* The outcome. Vote pages show it in their Result panel, so here only on one-column
        screens, where that panel falls below the chart. */}
    <p class:list={["quick-result", !embedded && "narrow-only"]}>
      <span class={`status-tag ${ok === true ? "ok" : ok === false ? "alert" : "neutral"}`}>{ok === true ? "Passed" : ok === false ? "Failed" : "Recorded"}</span>{" "}
      <span><b>{r.yea}</b> yes · <b>{r.nay}</b> no</span>{" "}
      {ok === true && r.chamber === "senate" && r.yea === r.nay && <span class="note">The Vice President broke the tie</span>}
    </p>
  </header>

  <div class="tabbar">
    <a class="tab-link" href="#vote-seats" aria-selected="true">Seat chart</a>
    <a class="tab-link" href="#vote-list" data-list-tab>Member list <span class="n">{votes.length}</span></a>
  </div>

  <!-- Seat chart -->
  <div class="tab-pane" id="vote-seats" data-pane="hemicycle">
    <div class="hemi-layout">
      <div class="hemi-main">
        <svg class="hemi" viewBox="-106 -106 212 114" role="group" aria-label={`Seat chart: ${r.yea} yes, ${r.nay} no. Each seat links to that member; use the arrow keys to move between seats.`}>
          <path d="M -104 4 A 104 104 0 0 1 104 4" class="arc" />
          {
            seated.map((v, i) => (
              <a href={`/members/${v.bioguide_id}`} data-id={v.bioguide_id} aria-label={`${v.full_name}, ${PARTY_NAMES[partyOf(v)]}: ${v.position === "yea" ? "yes" : v.position === "nay" ? "no" : (POSITION_LABELS[v.position] ?? v.position).toLowerCase()}`}>
                <circle cx={seats[i].x.toFixed(2)} cy={seats[i].y.toFixed(2)} r={dot.toFixed(2)} class={cls(v)} style={`--t:${(i / seated.length).toFixed(3)}`} />
              </a>
            ))
          }
          <rect x="-9" y="-3" width="18" height="3" class="dais" />
        </svg>

        {/* What a dot's fill means, then what its color means: two short keys instead of a code per party. */}
        <div class="legend label" role="group" aria-label="How to read the chart">
          <span class="lg-group">
            <span class="lg"><i class="k y" /> Yes</span>
            <span class="lg"><i class="k n" /> No</span>
            <span class="lg"><i class="k nv" /> Didn't vote</span>
          </span>
          <span class="lg-group">
            {
              parties.map((p) => (
                <span class="lg">
                  <i class={`k ${partyClass(p.p)} y`} /> <span class={`party ${partyClass(p.p)}`}>{PARTY_NAMES[p.p]}</span>
                </span>
              ))
            }
          </span>
        </div>
        <p class="note touch-tip">Tap a seat to see who sat there; tap again to open their page.</p>
      </div>

      <aside class="inspector" aria-label="Selected member">
        <p class="label insp-head">Selected member</p>
        <div class="viewfinder">
          <img alt="" hidden data-i="photo" />
          <span class="label nosignal" data-i="signal">No one selected</span>
        </div>
        <p class="insp-name" data-i="name">Point at a seat to see who sat there</p>
        <div class="kv">
          <div><span class="label">{r.chamber === "senate" ? "State" : "District"}</span><div class="v" data-i="district">--</div></div>
          <div><span class="label">Party</span><div class="v" data-i="party">--</div></div>
          <div class="insp-vote"><span class="label">Their vote</span><div class="v"><span class="status-tag neutral" data-i="vote">--</span></div></div>
        </div>
        <div class="rows-list">
          <div><span><Term tip={UNITY_TIP}>Votes with party</Term></span><span data-i="unity">--</span></div>
          <div><span>Bills sponsored</span><span data-i="sponsored">--</span></div>
          <div><span>In Congress</span><span data-i="tenure">--</span></div>
        </div>
        <a class="insp-open" data-i="open" href="#" hidden>Open their page <span aria-hidden="true">→</span></a>
      </aside>

      {/* Anything the page adds about the chart (the vote page's log) sits under it. */}
      {
        Astro.slots.has("log") && (
          <div class="hemi-log">
            <slot name="log" />
          </div>
        )
      }
    </div>
  </div>

  <!-- Member list -->
  <div class="tab-pane" id="vote-list" data-pane="registry">
    <div class="reg-top">
      <p class="label center">Final count</p>
      <div class="tally">
        <div><span class="label">Yes</span><span class="tnum" data-count={r.yea}>{r.yea}</span></div>
        <span class="margin label">{diff === 0 ? "Tied" : `${Math.abs(diff)} more ${diff > 0 ? "yes" : "no"}`}</span>
        <div><span class="label">No</span><span class="tnum dimnum" data-count={r.nay}>{r.nay}</span></div>
      </div>
      <TallyBar votes={votes} needed={t.needed} rule={ruleInfo(t).name} height={26} />

      <div class="parties">
        {
          parties.map((p) => (
            <div class={`pbox ${partyClass(p.p)}`}>
              <div class="pbox-head label">
                <span class={`party ${partyClass(p.p)}`}>{PARTY_NAMES[p.p]}</span>
                <span>{p.total} {p.total === 1 ? "member" : "members"}</span>
              </div>
              <div class="pbar"><span style={`width:${p.total ? (100 * p.yea) / p.total : 0}%`} /></div>
              <div class="pbox-foot label">
                <span>Yes <b>{p.yea}</b></span>
                <span>No <b>{p.nay}</b></span>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="reg-tools">
      <span class="label" id={`show-${r.id}`}>Show</span>
      <div class="toggles" data-filter-group role="group" aria-labelledby={`show-${r.id}`}>
        <button class="toggle active" type="button" data-show="all" aria-pressed="true">Everyone <span class="cnt">{votes.length}</span></button>
        <button class="toggle" type="button" data-show="yea" aria-pressed="false">Yes <span class="cnt">{r.yea}</span></button>
        <button class="toggle" type="button" data-show="nay" aria-pressed="false">No <span class="cnt">{r.nay}</span></button>
        {absent > 0 && <button class="toggle" type="button" data-show="absent" aria-pressed="false">Didn't vote <span class="cnt">{absent}</span></button>}
      </div>
      <input type="search" placeholder="Search by name or state" data-search aria-label="Find a member by name or state" />
    </div>
    <div class="table-scroll">
      <table class="rtable registry">
        <thead><tr><th>{r.chamber === "senate" ? "Senator" : "Representative"}</th><th>Party</th><th>State</th><th>District</th><th class="num">Their vote</th></tr></thead>
        <tbody>
          {
            registry.map((v) => (
              <tr
                data-href={`/members/${v.bioguide_id}`}
                data-id={v.bioguide_id}
                data-pos={v.position === "yea" ? "yea" : v.position === "nay" ? "nay" : "absent"}
                data-q={`${v.full_name} ${v.state} ${STATES[v.state ?? ""] ?? ""} ${memberTag({ ...v, chamber: r.chamber })}`.toLowerCase()}
              >
                <td><a href={`/members/${v.bioguide_id}`}>{v.full_name}</a></td>
                <td class="mono"><span class={`party ${partyClass(partyOf(v))}`}>{PARTY_NAMES[partyOf(v)]}</span></td>
                <td class="mono">{v.state}</td>
                <td class="mono">{r.chamber === "house" ? (v.district === 0 ? "At large" : (v.district ?? "--")) : "--"}</td>
                <td class="num">
                  <span class={`status-tag ${v.position === "yea" ? "ok" : v.position === "nay" ? "alert" : "neutral"}`}>
                    {v.position === "other" ? v.detail : POSITION_LABELS[v.position]}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="empty" data-none hidden>No members match. Check the spelling, try a state name, or choose Everyone.</p>
    <p class="pager"><span data-range aria-live="polite">Members</span><span class="pager-nav"><button class="toggle" type="button" data-prev>‹ Previous</button> <span data-page></span> <button class="toggle" type="button" data-next>Next ›</button></span></p>
  </div>

  <script type="application/json" data-seats set:html={JSON.stringify(seatData)} />
</div>

<script>
  import { countUp, fullArrival, go, reducedMotion } from "../scripts/fx";

  type Seat = { n: string; p: string; s: string; d: number | null; v: string; x: string | null; ph: string | null; u: number | null; sp: number | null; t: number | null; si: string | null };
  const PARTY: Record<string, string> = { D: "Democrat", R: "Republican", I: "Independent" };
  const VOTE: Record<string, string> = { yea: "Yes", nay: "No", present: "Present", not_voting: "Didn't vote" };

  for (const viz of document.querySelectorAll<HTMLElement>("[data-viz]")) {
    const seats = JSON.parse(viz.querySelector("script[data-seats]")?.textContent ?? "{}") as Record<string, Seat>;
    const chamber = viz.dataset.chamber;

    // Seats appear one after another, left to right.
    viz.querySelectorAll<SVGCircleElement>("circle.seat").forEach((c) => c.classList.add("seat-in"));

    // The tabs themselves are run by initTabs (fx.ts). On the first page of a visit the
    // list's tally counts up the first time it opens; after that the numbers just show.
    let counted = !fullArrival;
    viz.querySelector("[data-list-tab]")?.addEventListener("click", () => {
      if (counted) return;
      counted = true;
      viz.querySelectorAll<HTMLElement>("[data-pane=registry] [data-count]").forEach((el) => countUp(el, 600));
    });

    // Inspector: show a member when their seat is pointed at or focused. The text changes
    // at once (no decoding, so moving across seats stays calm); the portrait scans in once
    // it has loaded, and the old one dims meanwhile so it never sits under the wrong name.
    const field = (name: string) => viz.querySelector<HTMLElement>(`[data-i="${name}"]`);
    const photo = field("photo") as HTMLImageElement | null;
    let current = "";
    photo?.addEventListener("load", () => {
      photo.classList.remove("loading", "flash");
      void photo.offsetWidth;
      photo.classList.add("flash");
    });
    photo?.addEventListener("error", () => {
      photo.classList.remove("loading");
      photo.hidden = true;
      field("signal")!.hidden = false;
    });
    const show = (id: string) => {
      const m = seats[id];
      if (!m || id === current) return;
      current = id;
      const district = chamber === "house" ? (m.d === 0 ? `${m.s} at large` : `${m.s}-${m.d ?? "?"}`) : m.s;
      field("name")!.textContent = m.n;
      field("district")!.textContent = district;
      field("party")!.textContent = PARTY[m.p] ?? m.p;
      const vote = field("vote")!;
      vote.textContent = m.v === "other" ? (m.x ?? "Other") : (VOTE[m.v] ?? m.v);
      vote.className = `status-tag ${m.v === "yea" ? "ok" : m.v === "nay" ? "alert" : "neutral"}`;
      field("unity")!.textContent = m.u === null ? "--" : `${m.u}%`;
      field("sponsored")!.textContent = m.sp === null ? "--" : String(m.sp);
      field("tenure")!.textContent = m.t ? `Since ${m.si ?? "?"} · ${m.t} term${m.t === 1 ? "" : "s"}` : "--";
      const open = field("open") as HTMLAnchorElement | null;
      if (open) {
        open.href = `/members/${id}`;
        open.hidden = false;
      }
      // Once someone is selected, an empty frame means they have no photo on file.
      field("signal")!.textContent = "No photo";
      field("signal")!.hidden = Boolean(m.ph);
      if (!photo) return;
      if (!m.ph) {
        photo.hidden = true;
        return;
      }
      const next = new URL(m.ph, location.href).href;
      if (photo.src !== next) {
        photo.classList.add("loading");
        photo.src = next;
      }
      photo.hidden = false;
    };

    // The seat under the pointer, or the nearest one within about a seat's width, so the
    // small dots and the gaps between them are easy to point at.
    const svg = viz.querySelector<SVGSVGElement>("svg.hemi");
    const links = [...viz.querySelectorAll<SVGAElement>("svg.hemi a")];
    const centers = links.map((a) => {
      const c = a.querySelector("circle")!;
      return { a, c, x: Number(c.getAttribute("cx")), y: Number(c.getAttribute("cy")), r: Number(c.getAttribute("r")) };
    });
    let hot: (typeof centers)[number] | null = null;
    const setHot = (seat: typeof hot) => {
      if (seat === hot) return;
      hot?.c.classList.remove("hot");
      hot = seat;
      svg?.classList.toggle("pointing", Boolean(seat));
      if (!seat) return;
      seat.c.classList.add("hot");
      show(seat.a.dataset.id!);
    };
    // The nearest seat to a point on screen, within `reach` seat radii.
    const nearest = (clientX: number, clientY: number, reach: number) => {
      const m = svg?.getScreenCTM();
      if (!m) return null;
      const p = new DOMPoint(clientX, clientY).matrixTransform(m.inverse());
      let best: typeof hot = null;
      let bestD = Infinity;
      for (const s of centers) {
        const d = (s.x - p.x) ** 2 + (s.y - p.y) ** 2;
        if (d < bestD) {
          bestD = d;
          best = s;
        }
      }
      return best && Math.sqrt(bestD) <= best.r * reach ? best : null;
    };
    let frame = 0;
    svg?.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse" || frame) return;
      const { clientX, clientY } = event;
      frame = requestAnimationFrame(() => {
        frame = 0;
        setHot(nearest(clientX, clientY, 2.4));
      });
    });
    svg?.addEventListener("pointerleave", (event) => {
      if (event.pointerType !== "mouse") return; // a finger lifting keeps its chosen seat
      cancelAnimationFrame(frame);
      frame = 0;
      setHot(null);
    });
    // Choosing a seat by tap or keyboard also reveals the preview where it's normally hidden
    // (touch screens and phones), just below the chart.
    const inspector = viz.querySelector<HTMLElement>(".inspector");
    const pick = (seat: NonNullable<typeof hot>, reveal: boolean) => {
      setHot(seat);
      const wasHidden = !viz.classList.contains("picked") && inspector?.offsetParent === null;
      viz.classList.add("picked");
      if (reveal && wasHidden) inspector?.scrollIntoView({ block: "nearest", behavior: reducedMotion ? "auto" : "smooth" });
    };

    // Mouse: a click in the gap next to a highlighted seat opens that member, like a click on
    // the seat. Touch: the first tap on (or near) a seat shows who sat there; a second tap on
    // the same seat opens their page.
    let pointer = "mouse";
    let tapped: (typeof centers)[number] | null = null;
    svg?.addEventListener("pointerdown", (event) => (pointer = event.pointerType));
    svg?.addEventListener("click", (event) => {
      const onLink = (event.target as Element).closest("a");
      if (event.detail === 0) return; // Enter on a focused seat: follow its link
      if (pointer === "mouse") {
        if (hot && !onLink) go(hot.a.href.baseVal);
        return;
      }
      const seat = nearest(event.clientX, event.clientY, 3);
      if (!seat) return;
      if (seat === tapped) {
        if (!onLink) go(seat.a.href.baseVal);
        return;
      }
      event.preventDefault();
      tapped = seat;
      pick(seat, true);
    });

    // Keyboard: the chart is a single Tab stop. The arrow keys move along the arc (left and
    // right) or to the next row out or in (up and down); Enter opens the member.
    const radius = centers.map((s) => Math.round(Math.hypot(s.x, s.y) * 10) / 10);
    const angle = centers.map((s) => Math.atan2(-s.y, s.x));
    const rings = [...new Set(radius)].sort((a, b) => a - b);
    const ringStep = (i: number, step: number) => {
      const target = rings[rings.indexOf(radius[i]) + step];
      if (target === undefined) return i;
      let best = i;
      let bestD = Infinity;
      radius.forEach((r, k) => {
        const d = Math.abs(angle[k] - angle[i]);
        if (r === target && d < bestD) {
          bestD = d;
          best = k;
        }
      });
      return best;
    };
    links.forEach((a, i) => a.setAttribute("tabindex", i === 0 ? "0" : "-1"));
    links.forEach((a, i) =>
      a.addEventListener("focus", () => {
        links.forEach((x) => x.setAttribute("tabindex", x === a ? "0" : "-1"));
        // Only keyboard focus picks; a tap or click focuses the link too, and is handled above.
        if (a.matches(":focus-visible")) pick(centers[i], false);
      }),
    );
    svg?.addEventListener("keydown", (event) => {
      const i = links.indexOf(document.activeElement as SVGAElement);
      if (i < 0) return;
      const keys: Record<string, number> = {
        ArrowRight: Math.min(links.length - 1, i + 1),
        ArrowLeft: Math.max(0, i - 1),
        ArrowUp: ringStep(i, 1),
        ArrowDown: ringStep(i, -1),
        Home: 0,
        End: links.length - 1,
      };
      const n = keys[event.key];
      if (n === undefined) return;
      event.preventDefault();
      links[n].focus();
    });

    // Registry: filter, search, and pages of 15.
    const rows = [...viz.querySelectorAll<HTMLTableRowElement>("table.registry tbody tr")];
    const search = viz.querySelector<HTMLInputElement>("[data-search]");
    const filterButtons = viz.querySelectorAll<HTMLButtonElement>("[data-filter-group] [data-show]");
    let filter = "all";
    let page = 0;
    const PAGE = 15;
    const render = () => {
      const q = (search?.value ?? "").trim().toLowerCase();
      const matching = rows.filter((r) => (filter === "all" || r.dataset.pos === filter) && (!q || r.dataset.q!.includes(q)));
      const pages = Math.max(1, Math.ceil(matching.length / PAGE));
      page = Math.min(page, pages - 1);
      rows.forEach((r) => (r.hidden = true));
      matching.slice(page * PAGE, page * PAGE + PAGE).forEach((r) => (r.hidden = false));
      viz.querySelector("[data-range]")!.textContent = matching.length
        ? `Showing ${page * PAGE + 1}–${Math.min(matching.length, page * PAGE + PAGE)} of ${matching.length}`
        : "No members match";
      viz.querySelector("[data-page]")!.textContent = `Page ${page + 1} of ${pages}`;
      viz.querySelector<HTMLElement>("[data-none]")!.hidden = matching.length > 0;
      viz.querySelector<HTMLButtonElement>("[data-prev]")!.disabled = page === 0;
      viz.querySelector<HTMLButtonElement>("[data-next]")!.disabled = page >= pages - 1;
    };
    search?.addEventListener("input", () => {
      page = 0;
      render();
    });
    filterButtons.forEach((b) =>
      b.addEventListener("click", () => {
        filter = b.dataset.show!;
        page = 0;
        filterButtons.forEach((x) => {
          x.classList.toggle("active", x === b);
          x.setAttribute("aria-pressed", String(x === b));
        });
        render();
      }),
    );
    // Prev and Next fade the new page of rows in briefly, so the change registers.
    const body = rows[0]?.parentElement;
    const turn = (to: number) => {
      page = to;
      render();
      body?.classList.remove("page-in");
      void body?.offsetWidth;
      body?.classList.add("page-in");
    };
    viz.querySelector("[data-prev]")?.addEventListener("click", () => turn(Math.max(0, page - 1)));
    viz.querySelector("[data-next]")?.addEventListener("click", () => turn(page + 1));
    render();
  }
</script>

<style>
  .viz {
    position: relative;
  }
  /* A lighter tab bar than the page's own, since on bill pages it sits inside a tab. */
  .viz > .tabbar {
    background: transparent;
  }
  .viz > .tabbar .tab-link {
    min-height: 48px;
  }
  .viz-head {
    padding: var(--pad) var(--pad) 18px;
  }
  .viz-head > :last-child {
