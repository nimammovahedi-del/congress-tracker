---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { stat, type Topic } from "../lib/db";
import { CONGRESS, ordinal, SITE_NAME } from "../lib/format";

// One step of the breadcrumb trail shown above the page; the last one is the current page.
export interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  title: string;
  description?: string;
  crumbs?: Crumb[];
}
const { title, description = "Follow bills, votes, and your representatives in the U.S. Congress. Free.", crumbs = [] } = Astro.props;
const topics = await stat<Topic[]>("topics");
const ordinalCongress = ordinal(CONGRESS);
const path = Astro.url.pathname;
const current = (prefix: string) => (path === prefix || path.startsWith(`${prefix}/`) ? "page" : undefined);
// On the search page the bar's field keeps the words being searched for.
const query = path === "/search" ? (Astro.url.searchParams.get("q") ?? "").slice(0, 120) : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === SITE_NAME ? title : `${title} · ${SITE_NAME}`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/switzer-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/switzer-300.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/switzer-500.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // The theme, set before the first paint so a light page never flashes dark. Dark is the
      // default; the switch in the site bar saves a choice of light.
      (function (html) {
        var theme = "dark";
        try {
          if (localStorage.getItem("ct-theme") === "light") theme = "light";
        } catch (e) {}
        html.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').content = theme === "light" ? "#f6f5f1" : "#050505";
      })(document.documentElement);
      // Motion classes, set before the first paint. .fx turns the effects on, unless the
      // visitor asked for reduced motion. .calm marks every page after the first one of a
      // browser session: it arrives with a quick fade instead of the full sequence (fx.ts).
      (function (html) {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        html.classList.add("fx");
        try {
          if (sessionStorage.getItem("ct-arrived")) html.classList.add("calm");
          else sessionStorage.setItem("ct-arrived", "1");
        } catch (e) {
          html.classList.add("calm"); // storage blocked: the quieter choice
        }
      })(document.documentElement);
      // A portrait whose file is missing upstream shows its empty frame, not a broken-image
      // icon. Listening this early catches images that fail before the page scripts run.
      ["error", "load"].forEach(function (type) {
        document.addEventListener(
          type,
          function (e) {
            if (e.target && e.target.tagName === "IMG") e.target.classList.toggle("img-missing", type === "error");
          },
          true,
        );
      });
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-bar">
      <a class="brand" href="/"><Logo size={26} />{SITE_NAME}</a>

      <nav id="site-nav" class="nav" aria-label="Main">
        <ul>
          <li class="nav-topics">
            <a href="/topics" aria-current={current("/topics")}>Topics</a>
            {/* Opens the menu from the keyboard (and on touch screens, which can't hover). */}
            <button class="topics-open" type="button" aria-expanded="false" aria-controls="topics-menu" hidden>
              <span class="caret" aria-hidden="true">▾</span><span class="visually-hidden">Show the topics menu</span>
            </button>
            {
              topics && topics.length > 0 && (
                <div class="mega" id="topics-menu">
                  <div class="mega-inner">
                    <ul class="mega-areas">
                      {topics.map((t, i) => (
                        <li class={i === 0 ? "first" : undefined}>
                          <a href={`/topics/${t.slug}`}>
                            <span>{t.area}</span>
                            <span class="count">{t.bills.toLocaleString("en-US")}</span>
                          </a>
                          <div class="mega-subs">
                            <p class="label">{t.area}</p>
                            <ul>
                              {t.subjects.slice(0, 9).map((s) => (
                                <li>
                                  <a href={`/topics/${t.slug}?subject=${s.slug}`}>{s.name}</a>
                                </li>
                              ))}
                            </ul>
                            <a class="mega-all" href={`/topics/${t.slug}`}>
                              All {t.area} bills →
                            </a>
                          </div>
                        </li>
                      ))}
                    </ul>
                    <a class="mega-every" href="/topics">See all topics →</a>
                  </div>
                </div>
              )
            }
          </li>
          <li><a href="/votes" aria-current={current("/votes")}>Votes</a></li>
          <li><a href="/members" aria-current={current("/members")}>Members</a></li>
          <li><a href="/find" aria-current={current("/find")}>Find my rep</a></li>
          <li><a href="/analytics" aria-current={current("/analytics")}>Analytics</a></li>
          <li><a href="/about" aria-current={current("/about")}>About</a></li>
        </ul>
      </nav>

      <!-- Search, on every page: a field in the bar on wide screens; on phones the magnifier
           button opens it as a full-width row under the bar (without JavaScript it links to
           /search). Pressing "/" anywhere focuses it. -->
      <form class="bar-search" id="bar-search" action="/search" role="search">
        <label class="visually-hidden" for="bar-q">Search bills, members, and topics</label>
        <svg class="mag" viewBox="0 0 16 16" aria-hidden="true"><circle cx="6.8" cy="6.8" r="5" /><path d="M10.6 10.6 15 15" /></svg>
        <input id="bar-q" name="q" type="search" value={query} placeholder="Search bills, members, topics" autocomplete="off" enterkeyhint="search" />
        <kbd class="slash" title="Press / to search" aria-hidden="true">/</kbd>
        <button class="btn bar-go" type="submit">Search</button>
      </form>

      <button class="theme-switch" type="button" role="switch" aria-checked="false" aria-label="Light mode">
        <span class="knob" aria-hidden="true">
          <svg class="moon" viewBox="0 0 16 16"><path d="M13 9.6A5.5 5.5 0 0 1 6.4 3a5.5 5.5 0 1 0 6.6 6.6Z" /></svg>
          <svg class="sun" viewBox="0 0 16 16"><circle cx="8" cy="8" r="3" /><path d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1" /></svg>
        </span>
      </button>
      <a class="search-toggle" href="/search" aria-controls="bar-search" aria-expanded="false">
        <svg class="mag" viewBox="0 0 16 16" aria-hidden="true"><circle cx="6.8" cy="6.8" r="5" /><path d="M10.6 10.6 15 15" /></svg>
        <span class="visually-hidden">Search</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="visually-hidden">Menu</span>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </header>

    <main id="main">
      {
        crumbs.length > 0 && (
          <nav class="trail" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              {crumbs.map((c, i) => (
                <li>{c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current={i === crumbs.length - 1 ? "page" : undefined}>{c.label}</span>}</li>
              ))}
            </ol>
          </nav>
        )
      }
      <slot />
    </main>
    <script is:inline>
      // Also before the first paint: number the panels for the arrival stagger, and show only
      // the open pane of each tab box (the #hash's pane, else the selected tab's), so the page
      // doesn't jump when fx.ts wires up the tabs a moment later.
      (function () {
        document.querySelectorAll(".panel").forEach(function (panel, i) {
          panel.style.setProperty("--i", String(Math.min(i, 6)));
        });
        var target = null;
        try {
          target = location.hash.length > 1 ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
        } catch (e) {}
        document.querySelectorAll("[data-tabs]").forEach(function (box) {
          var tabs = [].filter.call(box.querySelectorAll("a.tab-link"), function (t) {
            return t.closest("[data-tabs]") === box;
          });
          var panes = tabs.map(function (t) {
            return document.getElementById(decodeURIComponent(t.hash.slice(1)));
          });
          if (!tabs.length || panes.indexOf(null) >= 0) return;
          var open = panes.findIndex(function (p) {
            return target && p.contains(target);
          });
          if (open < 0)
            open = Math.max(
              0,
              tabs.findIndex(function (t) {
                return t.getAttribute("aria-selected") === "true";
              }),
            );
          panes.forEach(function (p, k) {
            p.hidden = k !== open;
          });
          box.classList.add("tabs-on");
        });
      })();
    </script>

    <footer class="site-foot">
      <span>Free and nonpartisan · Not affiliated with Congress · {ordinalCongress} Congress</span>
      <nav class="foot-nav" aria-label="More">
        <a href="/about">About</a>
        <a href="/about#sources">Data sources</a>
        <a href="/search">Search</a>
      </nav>
    </footer>

    <script>
      import { boot, initClamp, initTabs, interceptLinks } from "../scripts/fx";

      boot();
      interceptLinks();

      // Light/dark switch: flips the theme now and remembers the choice on this device.
      const themeSwitch = document.querySelector<HTMLButtonElement>(".theme-switch")!;
      const showTheme = () => themeSwitch.setAttribute("aria-checked", String(document.documentElement.dataset.theme === "light"));
      showTheme();
      themeSwitch.addEventListener("click", () => {
        const light = document.documentElement.dataset.theme !== "light";
        document.documentElement.dataset.theme = light ? "light" : "dark";
        document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content = light ? "#f6f5f1" : "#050505";
        try {
          localStorage.setItem("ct-theme", light ? "light" : "dark");
        } catch {}
        showTheme();
      });
      initClamp();
      initTabs();

      // Topics menu. Pointing at "Topics" opens it (CSS). The ▾ button beside it opens it from
      // the keyboard, and on touch screens, which can't point, the first tap on "Topics" opens
      // it (a second tap follows the link). Escape, a click elsewhere, or moving the keyboard
      // focus out of it closes it again.
      const topicsItem = document.querySelector<HTMLLIElement>(".nav-topics");
      const topicsButton = document.querySelector<HTMLButtonElement>(".topics-open");
      const topicsLink = topicsItem?.querySelector<HTMLAnchorElement>(":scope > a");
      if (topicsItem && topicsButton && document.getElementById("topics-menu")) {
        topicsItem.classList.add("menu-js");
        topicsButton.hidden = false;
        const setTopics = (open: boolean) => {
          topicsItem.classList.toggle("open", open);
          topicsButton.setAttribute("aria-expanded", String(open));
        };
        topicsButton.addEventListener("click", () => setTopics(!topicsItem.classList.contains("open")));
        let touched = false;
        topicsLink?.addEventListener("pointerdown", (event) => (touched = event.pointerType !== "mouse"));
        topicsLink?.addEventListener("click", (event) => {
          if (!touched || topicsItem.classList.contains("open") || getComputedStyle(topicsButton).display === "none") return;
          event.preventDefault();
          setTopics(true);
        });
        topicsItem.addEventListener("keydown", (event) => {
          if (event.key !== "Escape" || !topicsItem.classList.contains("open")) return;
          setTopics(false);
          topicsButton.focus();
        });
        topicsItem.addEventListener("focusout", (event) => {
          if (!topicsItem.contains(event.relatedTarget as Node | null)) setTopics(false);
        });
        document.addEventListener("click", (event) => {
          if (!topicsItem.contains(event.target as Node)) setTopics(false);
        });
      }

      // Inside the menu: when one policy area is already showing its subtopics, wait a moment
      // before switching, so moving the pointer across to the subtopic list doesn't flip it.
      const areas = [...document.querySelectorAll<HTMLLIElement>(".mega-areas > li")];
      let pending = 0;
      const pick = (li: HTMLLIElement) => areas.forEach((a) => a.classList.toggle("on", a === li));
      areas[0]?.parentElement?.classList.add("js");
      if (areas[0]) pick(areas[0]);
      for (const li of areas) {
        li.addEventListener("mouseenter", () => {
          window.clearTimeout(pending);
          pending = window.setTimeout(() => pick(li), 130);
        });
        li.addEventListener("mouseleave", () => window.clearTimeout(pending));
        li.addEventListener("focusin", () => pick(li));
      }

      // Phone menu and phone search row: opening one closes the other.
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const searchToggle = document.querySelector<HTMLAnchorElement>(".search-toggle");
      const searchField = document.querySelector<HTMLInputElement>("#bar-q");
      const setMenu = (open: boolean) => {
        toggle?.setAttribute("aria-expanded", String(open));
        document.body.classList.toggle("menu-open", open);
      };
      const setSearch = (open: boolean) => {
        searchToggle?.setAttribute("aria-expanded", String(open));
        document.body.classList.toggle("search-open", open);
        if (open) {
          setMenu(false);
          searchField?.focus();
        }
      };
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "true";
        setMenu(open);
        if (open) setSearch(false);
      });
      searchToggle?.setAttribute("role", "button");
      searchToggle?.addEventListener("click", (event) => {
        event.preventDefault();
        setSearch(!document.body.classList.contains("search-open"));
      });

      // Explained terms (components/Term.astro): a tap or click pins the explanation open, since
      // touch screens can't hover; a tap elsewhere or Escape closes it. Each time one shows, it
      // is nudged sideways (or flipped above its word) to stay on screen.
      const placeTip = (term: Element) => {
        const tip = term.querySelector<HTMLElement>(".term-tip");
        if (!tip) return;
        requestAnimationFrame(() => {
          tip.style.setProperty("--dx", "0px");
          term.classList.remove("up");
          const box = tip.getBoundingClientRect();
          if (!box.width) return;
          const dx = box.right > window.innerWidth - 12 ? window.innerWidth - 12 - box.right : box.left < 12 ? 12 - box.left : 0;
          tip.style.setProperty("--dx", `${Math.round(dx)}px`);
          if (box.bottom > window.innerHeight - 8 && box.top - box.height > 80) term.classList.add("up");
        });
      };
      const closeTerms = (except?: Element | null) =>
        document.querySelectorAll(".term.open").forEach((t) => {
          if (t === except) return;
          t.classList.remove("open");
          t.querySelector(".term-btn")?.setAttribute("aria-expanded", "false");
        });
      document.addEventListener("click", (event) => {
        const button = (event.target as Element).closest?.(".term-btn");
        const term = button?.parentElement ?? null;
        closeTerms(term);
        if (!button || !term) return;
        const open = term.classList.toggle("open");
        button.setAttribute("aria-expanded", String(open));
        if (open) placeTip(term);
      });
      for (const type of ["pointerover", "focusin"]) {
        document.addEventListener(type, (event) => {
          const term = (event.target as Element).closest?.(".term");
          if (term && !term.contains((event as FocusEvent | PointerEvent).relatedTarget as Node | null)) placeTip(term);
        });
      }

      // "/" focuses the search field from anywhere on the page (except while typing); Escape leaves it.
      document.addEventListener("keydown", (event) => {
        if (event.key === "/" && !event.metaKey && !event.ctrlKey && !event.altKey) {
          if ((event.target as Element).closest?.("input, textarea, select, [contenteditable]")) return;
          event.preventDefault();
          if (searchToggle && getComputedStyle(searchToggle).display !== "none") setSearch(true);
          searchField?.focus();
          searchField?.select();
        } else if (event.key === "Escape" && document.activeElement === searchField) {
          searchField?.blur();
          setSearch(false);
        } else if (event.key === "Escape") {
          closeTerms();
        }
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    left: var(--gap);
    top: -60px;
    z-index: 80;
    padding: 10px 14px;
    background: var(--bright);
    color: var(--on-bright);
    font: 500 var(--fs-sm) var(--font);
  }
  .skip:focus {
    top: 8px;
  }
  .site-bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 22px;
    height: var(--bar);
    /* The bar spans the window, but its contents line up with the page's width cap. */
    padding: 0 max(var(--gap), calc((100% - var(--maxw)) / 2 + var(--gap)));
    border-bottom: 1px solid var(--line);
  }
  /* The frosted backdrop lives on a layer behind the bar: a backdrop-filter on the bar
     itself would make it the frame for its fixed children (the Topics menu and the phone
     menu), squeezing them into the bar's 46px. */
  .site-bar::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(var(--scrim) / 92%);
    backdrop-filter: blur(10px);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-right: 22px;
    border-right: 1px solid var(--line-2);
    font: 500 0.8rem/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bright);
    white-space: nowrap;
  }
  .nav {
    flex: 0 0 auto;
    align-self: stretch;
  }
  .nav > ul {
    display: flex;
    height: 100%;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav > ul > li {
    display: flex;
  }
  /* Each nav link fills the bar's height, so the pointer can't fall into a gap between the
     link and the Topics menu below it. */
  .nav > ul > li > a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    font: 400 0.94rem/1 var(--font);
    white-space: nowrap;
    color: var(--soft);
    transition:
      color 120ms ease,
      background 120ms ease;
  }
  .nav > ul > li > a:hover,
  .nav-topics:hover > a,
  .nav-topics.open > a {
    color: var(--bright);
    background: var(--raise);
  }
  .nav > ul > li > a[aria-current="page"] {
    color: var(--bright);
  }
  .nav > ul > li > a[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: -1px;
    height: 2px;
    background: var(--bright);
  }
  .caret {
    font-size: 0.7rem;
    color: var(--muted);
  }
  /* The ▾ beside "Topics" is its own button (it opens the menu from the keyboard and on touch
     screens), sharing the link's hover so the two read as one item. */
  .nav-topics.menu-js > a {
    padding-right: 2px;
  }
  .topics-open {
    display: inline-flex;
    align-items: center;
    padding: 0 12px 0 4px;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: background 120ms ease;
  }
  .topics-open[hidden] {
    display: none;
  }
  .nav-topics:hover > .topics-open,
  .nav-topics.open > .topics-open {
    background: var(--raise);
  }
  .topics-open:hover .caret,
  .nav-topics.open .caret {
    color: var(--bright);
  }
  .nav-topics.open .caret {
    display: inline-block;
    transform: rotate(180deg);
  }
  /* Light/dark switch: a small track with a knob that slides over and shows a sun or a moon. */
  .theme-switch {
    flex: 0 0 auto;
    position: relative;
    width: 46px;
    height: 26px;
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: 13px;
    background: var(--field);
    cursor: pointer;
    transition: border-color 120ms ease;
  }
  .theme-switch:hover {
    border-color: var(--muted);
  }
  .theme-switch:focus-visible {
    outline: 2px solid var(--bright);
    outline-offset: 2px;
  }
  .knob {
    position: absolute;
    top: 2px;
    left: 2px;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--bright);
    color: var(--on-bright);
    transition: transform 200ms var(--ease);
  }
  .theme-switch[aria-checked="true"] .knob {
    transform: translateX(20px);
  }
  .knob svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .moon {
    fill: currentColor !important;
    stroke: none !important;
  }
  .sun,
  .theme-switch[aria-checked="true"] .moon {
    display: none;
  }
  .theme-switch[aria-checked="true"] .sun {
    display: block;
  }
  /* The search field sits in the middle of the bar, in the space between the links and the
     update time. */
  .bar-search {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1 1 200px;
    min-width: 0;
    max-width: 420px;
    margin: 0 0 0 auto;
  }
  .mag {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .bar-search .mag {
    position: absolute;
    left: 12px;
    top: 50%;
    margin-top: -7.5px;
    color: var(--muted);
    pointer-events: none;
  }
  .bar-search input {
    flex: 1 1 auto;
    min-width: 0;
    height: 34px;
    padding: 0 40px 0 36px;
    font-size: 0.94rem;
    background: var(--panel);
    border-color: var(--line-2);
    transition:
      border-color 120ms ease,
      background 120ms ease;
  }
  .bar-search input:hover {
    border-color: var(--faint);
  }
  .bar-search input:focus {
    outline: none;
    border-color: var(--bright);
    background: var(--bg);
  }
  .bar-search input::placeholder {
    color: var(--muted);
  }
  .slash {
    position: absolute;
    right: 9px;
    top: 50%;
    min-width: 20px;
    margin-top: -10px;
    padding: 2px 5px;
    border: 1px solid var(--line-2);
    font: 400 var(--fs-xs)/14px var(--mono);
    text-align: center;
    color: var(--muted);
    pointer-events: none;
  }
  .bar-search input:focus ~ .slash,
  .bar-search input:not(:placeholder-shown) ~ .slash {
    display: none;
  }
  /* Enter submits on wide screens; the button shows only in the phone search row. */
  .bar-go {
    position: absolute;
    width: 1px;
    height: 1px;
    min-height: 0;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .search-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -6px;
    color: var(--bright);
  }
