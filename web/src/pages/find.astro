---
// Find your representatives from an address (via the U.S. Census Bureau's geocoder) or a
// state. The address is posted, not put in the URL, and never stored or logged.
import Panel from "../components/Panel.astro";
import Terminal, { type Line } from "../components/Terminal.astro";
import Layout from "../layouts/Layout.astro";
import { memberStats, rows } from "../lib/db";
import { CONGRESS, partyClass, PARTY, STATES } from "../lib/format";

// The Census vintage whose congressional districts match the Congress being tracked.
const VINTAGES: Record<number, string> = { 119: "ACS2025_Current", 120: "Current_Current" };

interface Rep {
  bioguide_id: string;
  full_name: string;
  party: string | null;
  state: string | null;
  district: number | null;
  chamber: string | null;
  phone: string | null;
  website: string | null;
  contact_form: string | null;
  photo_url: string | null;
}

let state = (Astro.url.searchParams.get("state") ?? "").toUpperCase();
let district: number | null = null;
let matched: string | null = null;
let error: string | null = null;
const lines: Line[] = [];

if (Astro.request.method === "POST") {
  const address = String((await Astro.request.formData()).get("address") ?? "").trim().slice(0, 200);
  if (address) {
    lines.push({ text: "Looking up the address with the U.S. Census Bureau…" });
    try {
      const url = new URL("https://geocoding.geo.census.gov/geocoder/geographies/onelineaddress");
      url.search = new URLSearchParams({ address, benchmark: "Public_AR_Current", vintage: VINTAGES[CONGRESS] ?? "Current_Current", format: "json" }).toString();
      const res = await fetch(url, { signal: AbortSignal.timeout(12_000) });
      const data = (await res.json()) as { result?: { addressMatches?: { matchedAddress: string; geographies: Record<string, Record<string, string>[]> }[] } };
      const hit = data.result?.addressMatches?.[0];
      if (!hit) {
        error = "No match for that address. Check the street and city, or pick your state below.";
        lines.push({ text: "No match found", tone: "alert" });
      } else {
        matched = hit.matchedAddress;
        const geo = hit.geographies;
        state = geo["States"]?.[0]?.STUSAB ?? "";
        const cdKey = Object.keys(geo).find((k) => /Congressional Districts/.test(k));
        const base = cdKey ? geo[cdKey]?.[0]?.BASENAME : undefined;
        district = base === undefined ? null : /^\d+$/.test(base) ? Number(base) : 0; // non-numeric = at-large
        lines.push({ text: `Match: ${matched}`, tone: "bright" });
        lines.push({ text: `Congressional district: ${state}-${district === 0 ? "at large" : (district ?? "?")}`, tone: "bright" });
      }
    } catch {
      error = "The Census Bureau's address lookup didn't respond. Try again, or pick your state below.";
      lines.push({ text: "The lookup timed out", tone: "alert" });
    }
  }
}

const validState = state in STATES ? state : "";
const reps = validState
  ? await rows<Rep>(
      `SELECT bioguide_id, full_name, party, state, district, chamber, phone, website, contact_form, photo_url
         FROM members WHERE in_office = 1 AND state = ? ORDER BY chamber DESC, district`,
      validState,
    )
  : [];
const senators = reps.filter((r) => r.chamber === "senate");
const house = district === null ? reps.filter((r) => r.chamber === "house") : reps.filter((r) => r.chamber === "house" && r.district === district);
const stats = reps.length ? new Map((await memberStats()).map((s) => [s.id, s])) : new Map();
if (reps.length) lines.push({ text: `Found ${senators.length + house.length} members of Congress`, tone: "ok" });
// Cards shown before "Show all" in a long list (Texas has 38 representatives).
const FOLD = 6;
const seatLabel = (r: Rep) => (r.chamber === "senate" ? "Senator" : `Representative · ${r.state}-${r.district === 0 ? "AL" : r.district}`);
---

<Layout title="Find my representatives" crumbs={validState ? [{ label: "Find my rep", href: "/find" }, { label: STATES[validState] ?? validState }] : [{ label: "Find my rep" }]}>
  <div class="console">
    <div class="cols cols-main-side">
      <Panel>
        <form class="panel-body cmd" method="post" action="/find">
          <h1 class="cmd-title">Find your representatives</h1>
          <label class="cmd-label" for="addr">Enter your home address to see your two senators and your member of the House.</label>
          <div class="cmd-line">
            <span aria-hidden="true">&gt;</span>
            <input id="addr" name="address" type="text" placeholder="Street address, city, state" autocomplete="street-address" required />
            <button class="go" type="submit">Find</button>
          </div>
          <p class="hint">Your address goes only to the U.S. Census Bureau's address lookup to find your district. It isn't stored.</p>
        </form>
      </Panel>
      <Panel label="Or pick a state">
        <form class="panel-body state-form" action="/find">
          <select name="state" aria-label="State" onchange="this.form.submit()">
            <option value="">Choose a state…</option>
            {Object.entries(STATES).map(([code, name]) => <option value={code} selected={code === validState}>{name}</option>)}
          </select>
          <noscript><button class="btn ghost" type="submit">Show</button></noscript>
        </form>
        {
          (lines.length > 0 || reps.length > 0) && (
            <Terminal lines={lines.length ? lines : [{ text: `State: ${STATES[validState]}`, tone: "bright" }, { text: `Found ${reps.length} members of Congress`, tone: "ok" }]} delay={200} />
          )
        }
      </Panel>
    </div>

    {error && <p class="error">{error}</p>}

    {
      [
        { title: senators.length === 1 ? "Senator" : "Senators", list: senators },
        { title: district === null ? `Members of the House · ${house.length}` : house.length === 1 ? "Your member of the House" : "Members of the House", list: house },
      ]
        .filter((g) => g.list.length > 0)
        .map((g, gi) => (
          <section class="group">
            <h2 class="group-title">
              {g.title}
              {matched && <span class="group-for"> · for {matched}</span>}
              {!matched && validState && <span class="group-for"> · {STATES[validState]}</span>}
            </h2>
            {gi === 0 && <p class="note group-note">“Votes with party” is how often they voted with most of their own party on votes where most Democrats and most Republicans took opposite sides.</p>}
            {/* A big state's House list shows its first few members and a button for the rest
                (every card shows without JavaScript). */}
            <div class="nodes" data-fold={g.list.length > FOLD + 2 ? FOLD : undefined}>
              {g.list.map((r, i) => {
                const s = stats.get(r.bioguide_id);
                const p = r.party === "D" || r.party === "R" ? r.party : "I";
                return (
                  <Panel label={seatLabel(r)} class={g.list.length > FOLD + 2 && i >= FOLD ? "more" : undefined}>
                    <a class="panel-body node" href={`/members/${r.bioguide_id}`}>
                      <span class="vf">{r.photo_url && <img src={r.photo_url} alt="" loading="lazy" />}<span class="cross" /></span>
                      <span class="info">
                        <span class="nname">{r.full_name}</span>
                        <span class={`party ${partyClass(p)}`}>{PARTY[p]?.name ?? p}</span>
                        <span class="rows-list">
                          <span><span>Votes with party</span><span>{s?.party_unity_pct ?? "--"}%</span></span>
                          <span><span>Missed votes</span><span>{s?.missed_pct ?? "--"}%</span></span>
                          <span><span>Bills sponsored</span><span>{s?.sponsored ?? 0}</span></span>
                        </span>
                      </span>
                    </a>
                    <div class="panel-body contact">
                      {r.phone && <a class="btn ghost" href={`tel:${r.phone}`}>Call {r.phone}</a>}
                      {r.contact_form && <a class="btn ghost" href={r.contact_form} target="_blank" rel="noopener">Write ↗</a>}
                      <a class="btn ghost" href={`/members/${r.bioguide_id}`}>Voting record →</a>
                    </div>
                  </Panel>
                );
              })}
            </div>
          </section>
        ))
    }
  </div>
</Layout>

<script>
  // Long lists fold after their first few cards, with a button that shows the rest.
  document.querySelectorAll<HTMLElement>(".nodes[data-fold]").forEach((grid) => {
    const hidden = grid.querySelectorAll(":scope > .more").length;
    if (!hidden) return;
    grid.classList.add("folded");
    const button = document.createElement("button");
    button.type = "button";
    button.className = "btn ghost show-all";
    button.textContent = `Show all ${grid.children.length} members of the House`;
    button.setAttribute("aria-expanded", "false");
    button.addEventListener("click", () => {
      grid.classList.remove("folded");
      button.remove();
      grid.querySelector<HTMLElement>(":scope > .more a")?.focus({ preventScroll: true });
    });
    grid.insertAdjacentElement("afterend", button);
  });
</script>

<style>
  /* The address form sits in the dark page like the home search: the inset field and button
     are styled in global.css. */
  .cmd {
    display: grid;
    gap: 12px;
    padding: clamp(20px, 3vw, 32px);
  }
  .cmd-title {
    margin: 0;
    font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.8rem);
  }
  .cmd-label {
    max-width: 60ch;
    color: var(--soft);
  }
  .cmd-line {
    margin-top: 4px;
  }
  .hint {
    max-width: 60ch;
    margin: 0;
    font: 400 var(--fs-sm)/1.5 var(--font);
    color: var(--muted);
  }
  .state-form {
    display: flex;
    gap: 8px;
  }
  .error {
    margin: var(--gap) 0 0;
    font-size: 0.95rem;
    color: var(--alert);
  }
  .group {
    margin-top: calc(var(--gap) * 2);
  }
  .group-title {
    margin: 0 0 var(--gap);
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.7rem);
  }
  .group-for {
    color: var(--muted);
  }
  .group-note {
    max-width: 75ch;
    margin: calc(var(--gap) * -0.5) 0 var(--gap);
  }
  :global(.folded) > .more {
    display: none;
  }
  .show-all {
    margin-top: var(--gap);
  }
  /* Cards are at least 340px wide: three across on a laptop, two on a tablet, one on a
     phone. The portrait gives up width before the numbers beside it do. */
  .nodes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: var(--gap);
  }
  .node {
    display: grid;
    grid-template-columns: min(110px, 30%) minmax(0, 1fr);
    gap: 16px;
  }
  .vf {
    position: relative;
    aspect-ratio: 450 / 550;
    border: 1px solid var(--line-2);
    background: #070707;
    overflow: hidden;
  }
  .vf img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
    transition: filter 200ms ease;
  }
  .node:hover .vf img {
    filter: none;
  }
  .cross {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: 50%;
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .nname {
    font-size: 1.3rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--bright);
  }
  .info .rows-list > span {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 7px 0;
    border-bottom: 1px solid var(--line);
    font: 0.9rem var(--mono);
  }
  .info .rows-list > span > span:first-child {
    font-size: var(--fs-xs);
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--muted);
  }
  .info .rows-list > span > span:last-child {
    color: var(--bright);
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border-top: 1px solid var(--line);
  }
  .contact .btn {
    padding: 9px 12px;
  }
</style>
