---
import Panel from "../../components/Panel.astro";
import SegBar from "../../components/SegBar.astro";
import StatusTag from "../../components/StatusTag.astro";
import StatusTracker from "../../components/StatusTracker.astro";
import VoteVisualizer from "../../components/VoteVisualizer.astro";
import Layout from "../../layouts/Layout.astro";
import { memberStats, memberVotes, row, rows, type Bill, type Member, type RollCall } from "../../lib/db";
import { billNumber, billNumberFromId, congressGovBillUrl, consoleDate, memberTag, memberTitle, ordinal, partyClass, sanitizeHtml, slugify, textLinks } from "../../lib/format";
import { passed, seatInfo } from "../../lib/votes";

const id = Astro.params.id ?? "";
const bill = await row<Bill>("SELECT * FROM bills WHERE id = ?", id);
// A bill that isn't loaded here (an older Congress, or not uploaded yet) opens on Congress.gov.
if (!bill) {
  const official = congressGovBillUrl(id);
  return official ? Astro.redirect(official, 302) : Astro.rewrite("/404");
}

const [sponsor, actions, cosponsors, subjects, related, cbo, rollCalls, pendingVotes] = await Promise.all([
  bill.sponsor_id ? row<Member>("SELECT * FROM members WHERE bioguide_id = ?", bill.sponsor_id) : null,
  // The source records some actions twice (once per reporting system); show each once.
  rows<{ action_date: string; text: string }>(
    "SELECT action_date, text FROM bill_actions WHERE bill_id = ? GROUP BY action_date, text ORDER BY MAX(seq) DESC",
    id,
  ),
  rows<{ bioguide_id: string; full_name: string | null; party: string | null; state: string | null; district: number | null; chamber: string | null; sponsorship_date: string | null; withdrawn_date: string | null }>(
    `SELECT c.bioguide_id, m.full_name, m.party, m.state, m.district, m.chamber, c.sponsorship_date, c.withdrawn_date
       FROM bill_cosponsors c LEFT JOIN members m ON m.bioguide_id = c.bioguide_id
      WHERE c.bill_id = ? ORDER BY c.withdrawn_date IS NOT NULL, c.sponsorship_date, m.last_name`,
    id,
  ),
  rows<{ subject: string }>("SELECT subject FROM bill_subjects WHERE bill_id = ? ORDER BY subject", id),
  rows<{ related_bill_id: string; relationship: string; title: string | null; here: number }>(
    `SELECT r.related_bill_id, MIN(r.relationship) AS relationship, b.title, b.id IS NOT NULL AS here
       FROM related_bills r LEFT JOIN bills b ON b.id = r.related_bill_id
      WHERE r.bill_id = ? GROUP BY r.related_bill_id ORDER BY r.related_bill_id LIMIT 20`,
    id,
  ),
  rows<{ pub_date: string | null; title: string | null; url: string }>("SELECT pub_date, title, url FROM cbo_estimates WHERE bill_id = ? ORDER BY pub_date DESC", id),
  rows<RollCall>("SELECT * FROM roll_calls WHERE bill_id = ? ORDER BY vote_date DESC, roll_number DESC", id),
  // Votes the bill's history mentions that aren't in our vote data yet (Senate votes arrive
  // from Voteview up to a month later).
  rows<{ roll_call_id: string; action_date: string | null; action_text: string | null }>(
    `SELECT v.roll_call_id, v.action_date, v.action_text FROM bill_vote_refs v
      WHERE v.bill_id = ? AND v.roll_call_id NOT IN (SELECT id FROM roll_calls) ORDER BY v.action_date DESC`,
    id,
  ),
]);

// Show the most decisive vote in full: final passage if there was one, else the latest vote.
const decisive = /passage|and pass|concur|agreeing to the (resolution|conference)|override|on the (joint |concurrent )?resolution/i;
const keyVote = rollCalls.find((r) => decisive.test(r.question ?? "")) ?? rollCalls[0] ?? null;
const [keyVotes, stats] = keyVote ? await Promise.all([memberVotes(keyVote.id), memberStats()]) : [[], []];

const links = textLinks(bill.text_url);

// AI-written summary (see summaries/bills/ in the repo). "full" stands in for a missing
// official summary; "clarification" adds plain English beside a thin one.
interface AiSummary {
  kind: "full" | "clarification";
  overview: string;
  for: string;
  against: string;
  text_version?: string | null;
  text_url?: string | null;
  written?: string | null;
}
let ai: AiSummary | null = null;
try {
  ai = bill.ai_summary ? (JSON.parse(bill.ai_summary) as AiSummary) : null;
} catch {
  ai = null;
}
// The two sides sit under "Supporters say" / "Critics say" labels, and the written text opens
// with the same words, so they're dropped from the text ("Critics say that, although…" reads
// "Although…") instead of being said twice.
const sideText = (text: string, who: string) => {
  const rest = text.replace(new RegExp(`^${who} say(?:s)?(?: that)?,?\\s+`, "i"), "");
  return rest === text ? text : rest.charAt(0).toUpperCase() + rest.slice(1);
};
const active = cosponsors.filter((c) => !c.withdrawn_date);
const byParty = ["D", "R", "I"].map((p) => ({ p, n: active.filter((c) => (c.party === "D" || c.party === "R" ? c.party : "I") === p).length }));
const SHOWN = 30;
const number = billNumber(bill.bill_type, bill.number);
// What to call it in sentences: resolutions aren't bills.
const noun = bill.bill_type.endsWith("res") ? "resolution" : "bill";
const voteCount = rollCalls.length + pendingVotes.length;
// How a related bill is related, in words (a few arrive as codes from the source data).
const RELATIONSHIPS: Record<string, string> = {
  "Related bill": "Related",
  "Identical bill": "Identical text",
  "Cross-Congress related bill": "From another Congress",
  "Procedurally related": "Procedurally related",
  "Contained in public law": "Included in a law",
  "Public law contains the text": "Its text became law",
  PrimaryCompanionBillBecameLaw: "Companion became law",
  SecondaryCompanionBillBecameLaw: "Companion became law",
};
const relationship = (r: string) => RELATIONSHIPS[r] ?? r.replace(/([a-z])([A-Z])/g, "$1 $2");
const PARTY_PLURAL: Record<string, string> = { D: "Democrats", R: "Republicans", I: "Independents" };
---

<Layout title={`${number}: ${bill.title}`} description={bill.official_title ?? bill.title} crumbs={bill.policy_area ? [{ label: "Topics", href: "/topics" }, { label: bill.policy_area, href: `/topics/${slugify(bill.policy_area)}` }, { label: number }] : [{ label: "Search", href: "/search" }, { label: number }]}>
  <div class="console">
    <Panel class="head">
      <div class="panel-body head-body">
        <div class="head-main">
          <p class="label">
            <span data-scramble>{bill.bill_type.endsWith("res") ? "Resolution" : "Bill"}</span> <span class="faint">·</span> {ordinal(bill.congress)} Congress
            {bill.law_number && <> <span class="faint">·</span> <span class="ok">Public Law {bill.law_number}</span></>}
          </p>
          <h1 class="measure cursor"><span data-scramble>{number}</span></h1>
          <p class="title">{bill.title}</p>
          {bill.official_title && bill.official_title !== bill.title && <p class="official">{bill.official_title}</p>}
          <div class="meta">
            <StatusTag status={bill.status} />
            {bill.introduced_date && <span class="label">Introduced {consoleDate(bill.introduced_date)}</span>}
            {bill.policy_area && <a class="toggle" href={`/topics/${slugify(bill.policy_area)}`}>Topic: {bill.policy_area} →</a>}
          </div>
        </div>

        <aside class="head-side">
          {
            sponsor && (
              <a class="sponsor" href={`/members/${sponsor.bioguide_id}`}>
                <span class="portrait">{sponsor.photo_url && <img src={sponsor.photo_url} alt="" loading="lazy" />}</span>
                <span class="sponsor-text">
                  <span class="label">Introduced by</span>
                  <span class="sponsor-name">{memberTitle(sponsor.chamber)} {sponsor.full_name}</span>
                  <span class={`party ${partyClass(sponsor.party)}`}>{memberTag(sponsor)}</span>
                </span>
              </a>
            )
          }
          <a class="support" href="#cosponsors">
            <span class="support-head">
              <span class="label">Cosponsors</span>
              <span class="support-n">{active.length}</span>
            </span>
            {
              active.length ? (
                <span class="mix">
                  {byParty.filter((x) => x.n > 0).map((x) => (
                    <span class="mix-row">
                      <span class={`party ${partyClass(x.p)}`}>{PARTY_PLURAL[x.p]} {x.n}</span>
                      <SegBar value={x.n} max={active.length} cells={20} height={8} tone={x.p === "D" ? "dem" : x.p === "R" ? "rep" : "ind"} label={`${x.n} ${x.p === "D" ? "Democratic" : x.p === "R" ? "Republican" : "Independent"} cosponsors`} />
                    </span>
                  ))}
                </span>
              ) : (
                <span class="note">No cosponsors</span>
              )
            }
          </a>
        </aside>
      </div>
      <div class="panel-body">
        <StatusTracker billType={bill.bill_type} status={bill.status} originChamber={bill.origin_chamber} />
        {bill.latest_action_text && <p class="latest"><span class="label">Latest action · {consoleDate(bill.latest_action_date)}</span><br />{bill.latest_action_text}</p>}
        <div class="links">
          {links && <a class="btn" href={links.html} target="_blank" rel="noopener">Read the bill text{bill.text_version ? ` · ${bill.text_version}` : ""} ↗</a>}
          {links && <a class="btn ghost" href={links.pdf} target="_blank" rel="noopener">PDF ↗</a>}
          <a class="btn ghost" href={bill.congress_gov_url} target="_blank" rel="noopener">Congress.gov ↗</a>
        </div>
      </div>
    </Panel>

    <Panel class="record">
      <div data-tabs>
        <div class="tabbar">
          <a class="tab-link" href="#summary" aria-selected="true">Summary</a>
          <a class="tab-link" href="#votes">Votes <span class="n">{voteCount}</span></a>
          <a class="tab-link" href="#timeline">Timeline <span class="n">{actions.length}</span></a>
          <a class="tab-link" href="#cosponsors">Cosponsors <span class="n">{active.length}</span></a>
          <a class="tab-link" href="#details">Details</a>
        </div>

        <section class="tab-pane" id="summary">
          <header class="pane-head">
            <h2>What this {noun} does</h2>
          </header>
          {
            ai && (
              <div class="panel-body ai-summary">
                <div class="lead">
                  <p class="label ai-tag">Overview</p>
                  <p class="overview">{ai.overview}</p>
                </div>
                <div class="debate">
                  <div class="side">
                    <p class="label">Supporters say</p>
                    <p>{sideText(ai.for, "Supporters")}</p>
                  </div>
                  <div class="side">
                    <p class="label">Critics say</p>
                    <p>{sideText(ai.against, "Critics")}</p>
                  </div>
                </div>
              </div>
            )
          }
          {
            bill.crs_summary ? (
              <div class="panel-body">
                {ai && <p class="label official-head">Official summary · Congressional Research Service</p>}
                <div class="prose" data-clamp="560" data-more="Show the full summary" data-less="Show less" set:html={sanitizeHtml(bill.crs_summary)} />
                <p class="note source">
                  Congressional Research Service · {bill.crs_summary_version ?? "summary"}{bill.crs_summary_date && <> · {consoleDate(bill.crs_summary_date)}</>}
                </p>
              </div>
            ) : (
              !ai && (
                <div class="panel-body">
                  <p class="empty">No summary yet</p>
                </div>
              )
            )
          }
        </section>

        <section class="tab-pane" id="votes">
          <header class="pane-head">
            <h2>How Congress voted</h2>
          </header>
          {
            keyVote ? (
              <>
                <VoteVisualizer rollCall={keyVote} votes={keyVotes} seats={seatInfo(keyVotes, stats)} billTitle={bill.title} embedded />
                <div class="panel-body vote-actions">
                  <a class="btn ghost" href={`/votes/${keyVote.id}`}>Full vote record →</a>
                </div>
              </>
            ) : (
              pendingVotes.length === 0 && (
                <p class="empty">
                  No recorded votes yet. Many bills pass by voice vote or unanimous consent, where no one's individual vote is written down.
                </p>
              )
            )
          }
          {
            pendingVotes.length > 0 && (
              <div class="panel-body pending">
                <p class="note">Senate vote details arrive within about a month</p>
                {pendingVotes.map((v) => (
                  <p class="pending-row"><span class="label">{consoleDate(v.action_date)}</span> {v.action_text}</p>
                ))}
              </div>
            )
          }
          {
            rollCalls.length > 1 && (
              <div class="other-votes">
                <p class="label list-title">Every recorded vote on this {noun}</p>
                <ol class="reclist">
                  {rollCalls.map((r) => {
                    const ok = passed(r);
                    return (
                      <li>
                        <a href={`/votes/${r.id}`}>
                          <span class="tag">{r.chamber === "senate" ? "Senate" : "House"} {r.roll_number}</span>
                          <span class="rl-title">{r.question}</span>
                          <span class="rl-meta">
                            <span class={`status-tag ${ok === true ? "ok" : ok === false ? "alert" : "neutral"}`}>{ok === true ? "Passed" : ok === false ? "Failed" : "Recorded"}</span>
                            <span>{consoleDate(r.vote_date)} · {r.yea}–{r.nay}</span>
                          </span>
                        </a>
                      </li>
                    );
                  })}
                </ol>
              </div>
            )
          }
        </section>

        <section class="tab-pane" id="timeline">
          <header class="pane-head">
            <h2>Timeline</h2>
          </header>
          <ol class="history" data-clamp="620" data-more="Show the whole timeline" data-less="Show less">
            {
              actions.map((a, i) => (
                <li class={i === 0 ? "now" : undefined}>
                  <span class="label">{consoleDate(a.action_date)}</span>
                  <span>{a.text}</span>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="tab-pane" id="cosponsors">
          <header class="pane-head">
            <h2>Cosponsors</h2>
            <p>{active.length ? `${active.length} ${active.length === 1 ? "member" : "members"}` : "None yet"}</p>
          </header>
          {
            active.length > 0 && (
              <div class="panel-body">
                <ul class="people">
                  {active.slice(0, SHOWN).map((c) => (
                    <li>
                      <a href={`/members/${c.bioguide_id}`}>{c.full_name ?? c.bioguide_id}</a>
                      <span class={`party ${partyClass(c.party)}`}>{memberTag(c)}</span>
                    </li>
                  ))}
                </ul>
                {active.length > SHOWN && (
                  <details>
                    <summary>Show all {active.length}</summary>
                    <ul class="people">
                      {active.slice(SHOWN).map((c) => (
                        <li>
                          <a href={`/members/${c.bioguide_id}`}>{c.full_name ?? c.bioguide_id}</a>
                          <span class={`party ${partyClass(c.party)}`}>{memberTag(c)}</span>
                        </li>
                      ))}
                    </ul>
                  </details>
                )}
              </div>
            )
          }
        </section>

        <section class="tab-pane" id="details">
          <header class="pane-head">
            <h2>Details</h2>
          </header>
          <div class="details-grid">
            <div class="panel-body">
              <p class="label list-title">Related bills</p>
              {
                related.length ? (
                  <div class="related">
                    {related.map((r) => (
                      <a href={r.here ? `/bills/${r.related_bill_id}` : (congressGovBillUrl(r.related_bill_id) ?? `/bills/${r.related_bill_id}`)} target={r.here ? undefined : "_blank"} rel={r.here ? undefined : "noopener"}>
                        <span class="tag">{billNumberFromId(r.related_bill_id)}</span>
                        <span class="rel-title clamp-2">{r.title ?? (r.here ? "" : `On Congress.gov${r.related_bill_id.startsWith(`${bill.congress}-`) ? "" : ` · ${ordinal(Number(r.related_bill_id.split("-")[0]))} Congress`} ↗`)}</span>
                        <span class="label">{relationship(r.relationship)}</span>
                      </a>
                    ))}
                  </div>
                ) : (
                  <p class="note">None listed</p>
                )
              }
            </div>
            <div class="panel-body">
              <p class="label list-title">Cost estimates · Congressional Budget Office</p>
              {
                cbo.length ? (
                  <div class="rows-list cbo">
                    {cbo.map((e) => (
                      <div>
                        <a href={e.url} target="_blank" rel="noopener">{(e.title ?? "Estimate").replace(/&#0?39;/g, "'").replace(/&amp;/g, "&")} ↗</a>
                        <span>{consoleDate(e.pub_date)}</span>
                      </div>
                    ))}
                  </div>
                ) : (
                  <p class="note">None published</p>
                )
              }
            </div>
          </div>
          {
            subjects.length > 0 && (
              <div class="panel-body subjects">
                <p class="label list-title">Subject tags · {subjects.length}</p>
                <div class="chips">
                  {subjects.slice(0, 24).map((s) => (
                    <span class="chip">{s.subject}</span>
                  ))}
                </div>
                {subjects.length > 24 && (
                  <details>
                    <summary>Show all {subjects.length}</summary>
                    <div class="chips more-chips">
                      {subjects.slice(24).map((s) => (
                        <span class="chip">{s.subject}</span>
                      ))}
                    </div>
                  </details>
                )}
              </div>
            )
          }
        </section>
      </div>
    </Panel>
  </div>
</Layout>

<style>
  .head-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    gap: 24px 40px;
    padding: clamp(18px, 2.6vw, 32px);
  }
  .measure {
    margin: 12px 0 8px;
    font-size: clamp(2.8rem, 1.8rem + 3.6vw, 5.4rem);
    font-weight: 600;
    letter-spacing: -0.045em;
  }
  .title {
    max-width: 50ch;
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.6rem);
    line-height: 1.25;
    color: var(--bright);
    letter-spacing: -0.015em;
  }
  .official {
    max-width: 75ch;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.5;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 14px;
  }
  .head-side {
    display: grid;
    align-content: start;
    gap: 10px;
  }
  .sponsor,
  .support {
    display: block;
    padding: 14px;
    border: 1px solid var(--line-2);
    background: var(--panel-2);
    transition:
      border-color 120ms ease,
      background 120ms ease;
  }
  .sponsor:hover,
  .support:hover {
    border-color: var(--muted);
    background: var(--raise);
  }
  .sponsor {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 14px;
    align-items: center;
  }
  .portrait {
    display: block;
    aspect-ratio: 450 / 550;
    border: 1px solid var(--line-2);
    background: var(--panel-2);
    overflow: hidden;
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
    transition: filter 200ms ease;
  }
  .sponsor:hover .portrait img {
    filter: none;
  }
  .sponsor-text {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .sponsor-name {
    font-size: 1.05rem;
    line-height: 1.2;
    color: var(--bright);
    letter-spacing: -0.01em;
  }
  .support-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 10px;
  }
  .support-n {
    font: 400 1.3rem/1 var(--mono);
    color: var(--bright);
  }
  /* One grid for all the rows: the label column is as wide as the longest label
     ("Republicans 51"), so the bars start together and never run over a label. */
  .mix {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: center;
    gap: 8px 12px;
  }
  .mix-row {
    display: contents;
  }
  .latest {
    margin: 22px 0 0;
    max-width: 75ch;
    color: var(--soft);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }
  .record {
    margin-top: var(--gap);
  }
  .source {
    margin: 16px 0 0;
  }
  /* The overview reads on the left; on wide screens the case for and against sits in a
     column to its right instead of below it. */
  .ai-summary {
    display: grid;
    gap: 18px 32px;
  }
  @media (min-width: 1100px) {
    .ai-summary {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: start;
    }
    .ai-summary .debate {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 0;
    }
  }
  .ai-tag {
    margin-bottom: 10px;
  }
  .overview {
    max-width: 68ch;
    font-size: var(--fs-lg);
    line-height: 1.65;
    color: var(--text);
  }
  /* For and against sit side by side in identical, neutral boxes so neither looks favored. */
  .debate {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 12px;
    margin-top: 18px;
  }
  .side {
    padding: 14px 16px;
    border: 1px solid var(--line-2);
    background: var(--panel-2);
  }
  .side .label {
    margin-bottom: 8px;
  }
  .side p:last-child {
    margin: 0;
    line-height: 1.6;
    color: var(--soft);
  }
  .official-head {
    margin-bottom: 10px;
  }
  .vote-actions {
    border-top: 1px solid var(--line);
  }
  .pending {
    border-top: 1px solid var(--line);
  }
  .pending-row {
    margin: 10px 0 0;
    font-size: 0.94rem;
  }
  .list-title {
    margin: 0 0 10px;
  }
  .other-votes {
    border-top: 1px solid var(--line);
  }
  .other-votes .list-title {
    padding: 16px var(--pad) 0;
  }
  .history {
    list-style: none;
    margin: 0;
    padding: 4px var(--pad) var(--pad);
  }
  #timeline :global(.clamp-toggle) {
    margin: 0 var(--pad) var(--pad);
  }
  .history li {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--soft);
  }
  .history .label {
    padding-top: 3px;
  }
  .history li.now {
    color: var(--bright);
  }
  .history li.now .label {
    color: var(--ok);
  }
  .people {
    columns: 3 260px;
    column-gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .people li {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
    break-inside: avoid;
  }
  .people a:hover {
    color: var(--bright);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .details-grid {
