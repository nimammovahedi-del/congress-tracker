---
import Panel from "../components/Panel.astro";
import SegBar from "../components/SegBar.astro";
import StatusTag from "../components/StatusTag.astro";
import Layout from "../layouts/Layout.astro";
import { BILL_LIST_COLUMNS, BILL_LIST_JOIN, row, rows, stat, type BillListItem, type RollCall, type Topic } from "../lib/db";
import { addDays, billNumber, consoleDate, formatShortDate, formatDate, CONGRESS, lastName, ordinal, partyClass, SITE_NAME } from "../lib/format";
import { passed, voteRef } from "../lib/votes";

// "This week" is the 7 days ending on the latest day with any action, so the page stays
// useful during recesses.
const latest = (await row<{ d: string }>("SELECT MAX(latest_action_date) AS d FROM bills"))?.d ?? new Date().toISOString().slice(0, 10);
const weekStart = addDays(latest, -6);
const MOVED = "('passed_house', 'passed_senate', 'passed_both', 'presented', 'vetoed', 'agreed', 'became_law')";

const [overview, moved, votes, laws, introduced, week, topics] = await Promise.all([
  stat<{ bills: number; laws: number; votes: number; yea_total: number; nay_total: number; vote_pass_pct: number; members: number }>("overview"),
  rows<BillListItem>(
    `SELECT ${BILL_LIST_COLUMNS} FROM bills b ${BILL_LIST_JOIN}
      WHERE b.status IN ${MOVED} AND b.status_date >= ? ORDER BY b.status_date DESC LIMIT 8`,
    weekStart,
  ),
  rows<RollCall & { bill_title: string | null }>(
    `SELECT r.*, b.title AS bill_title FROM roll_calls r LEFT JOIN bills b ON b.id = r.bill_id
      ORDER BY r.vote_date DESC, r.roll_number DESC LIMIT 8`,
  ),
  rows<BillListItem>(
    `SELECT ${BILL_LIST_COLUMNS} FROM bills b ${BILL_LIST_JOIN}
      WHERE b.status = 'became_law' ORDER BY b.status_date DESC LIMIT 5`,
  ),
  rows<BillListItem & { introduced_date: string | null }>(
    `SELECT ${BILL_LIST_COLUMNS}, b.introduced_date FROM bills b ${BILL_LIST_JOIN}
      WHERE b.introduced_date >= ? ORDER BY b.introduced_date DESC, b.cosponsor_count DESC LIMIT 8`,
    weekStart,
  ),
  row<{ introduced: number; moved: number; laws: number; votes: number }>(
    `SELECT (SELECT COUNT(*) FROM bills WHERE introduced_date >= ?1) AS introduced,
            (SELECT COUNT(*) FROM bills WHERE status IN ${MOVED} AND status_date >= ?1) AS moved,
            (SELECT COUNT(*) FROM bills WHERE status = 'became_law' AND status_date >= ?1) AS laws,
            (SELECT COUNT(*) FROM roll_calls WHERE vote_date >= ?1) AS votes`,
    weekStart,
  ),
  stat<Topic[]>("topics"),
]);

const yeaMax = Math.max(overview?.yea_total ?? 0, overview?.nay_total ?? 0, 1);
// Open the first tab that has something in it.
const firstTab = moved.length ? "moving" : "latest-votes";
---

<Layout title={SITE_NAME}>
  <div class="console">
    <Panel class="hero">
      <div class="panel-body hero-body">
        <div class="hero-text">
          <p class="label"><span data-scramble>Week of {formatShortDate(weekStart)} – {formatDate(latest)}</span></p>
          <h1 class="cursor"><span data-scramble>This week in Congress</span></h1>
          <p class="intro">
            {SITE_NAME} is a free, nonpartisan record of every bill, vote, and member of the {ordinal(CONGRESS)} Congress. These numbers cover the most recent week with activity.
            {(week?.votes ?? 0) === 0 && " There were no recorded votes that week, which can happen when Congress is on a break. The Latest votes tab below has the most recent ones."}
          </p>
        </div>
        <div class="week">
          <a class="statbox week-box" href="#new">
            <span class="label">New bills introduced</span>
            <span class="value" data-count={week?.introduced ?? 0}>{week?.introduced ?? 0}</span>
            <span class="go-hint" aria-hidden="true">→</span>
          </a>
          <a class="statbox week-box" href="#moving">
            <span class="label">Bills that moved forward</span>
            <span class="value" data-count={week?.moved ?? 0}>{week?.moved ?? 0}</span>
            <span class="go-hint" aria-hidden="true">→</span>
          </a>
          <a class="statbox week-box" href="#laws">
            <span class="label">Signed into law</span>
            <span class="value ok" data-count={week?.laws ?? 0}>{week?.laws ?? 0}</span>
            <span class="go-hint" aria-hidden="true">→</span>
          </a>
          <a class="statbox week-box" href="#latest-votes">
            <span class="label">Recorded votes</span>
            <span class="value" data-count={week?.votes ?? 0}>{week?.votes ?? 0}</span>
            <span class="go-hint" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </Panel>

    <Panel class="search-panel">
      <form class="panel-body cmd" action="/search" role="search">
        <label class="cmd-label" for="home-q">Search bills, members, and topics</label>
        <div class="cmd-line">
          <span aria-hidden="true">&gt;</span>
          <input id="home-q" name="q" type="search" placeholder="Try H.R. 1 or veterans" autocomplete="off" />
          <button class="go" type="submit">Search</button>
        </div>
        <ul class="quick">
          <li><a href="/find">Find your representatives <span aria-hidden="true">→</span></a></li>
          <li><a href="/topics">Browse bills by topic <span aria-hidden="true">→</span></a></li>
          <li><a href="/votes">See every vote <span aria-hidden="true">→</span></a></li>
          <li><a href="/members">All members of Congress <span aria-hidden="true">→</span></a></li>
        </ul>
      </form>
    </Panel>

    <Panel class="activity">
      <div data-tabs>
        <div class="tabbar">
          <a class="tab-link" href="#moving" aria-selected={firstTab === "moving" ? "true" : undefined}>Moving forward <span class="n">{moved.length}</span></a>
          <a class="tab-link" href="#latest-votes" aria-selected={firstTab === "latest-votes" ? "true" : undefined}>Latest votes</a>
          <a class="tab-link" href="#laws">New laws</a>
          <a class="tab-link" href="#new">Just introduced <span class="n">{week?.introduced ?? 0}</span></a>
        </div>

        <section class="tab-pane" id="moving">
          <header class="pane-head">
            <h2>Bills that moved forward this week</h2>
            <p>Passed the House or Senate, went to the President, or became law.</p>
          </header>
          {
            moved.length ? (
              <ol class="reclist">
                {moved.map((b) => (
                  <li>
                    <a href={`/bills/${b.id}`}>
                      <span class="tag">{billNumber(b.bill_type, b.number)}</span>
                      <span class="rl-title">{b.title}</span>
                      <span class="rl-meta"><StatusTag status={b.status} /><span>{consoleDate(b.status_date)}</span></span>
                    </a>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="empty">No bills moved forward this week</p>
            )
          }
        </section>

        <section class="tab-pane" id="latest-votes">
          <header class="pane-head">
            <h2>Latest votes</h2>
            <p>The {votes.length} most recent votes in the House and Senate where each member's vote was recorded.</p>
          </header>
          <ol class="reclist">
            {
              votes.map((v) => {
                const ok = passed(v);
                return (
                  <li>
                    <a href={`/votes/${v.id}`}>
                      <span class="tag">{voteRef(v)}</span>
                      <span class="rl-title has-sub">
                        <span class="clamp-2">{v.bill_title ?? v.description ?? v.question}</span>
                        {(v.bill_title ?? v.description) && v.question && <span class="rl-sub">{v.question}</span>}
                      </span>
                      <span class="rl-meta">
                        <span class={`status-tag ${ok === true ? "ok" : ok === false ? "alert" : "neutral"}`}>{ok === true ? "Passed" : ok === false ? "Failed" : "Recorded"}</span>
                        <span>{v.chamber === "senate" ? "Senate" : "House"} · {consoleDate(v.vote_date)}</span>
                      </span>
                    </a>
                  </li>
                );
              })
            }
          </ol>
          <p class="pager"><span>Showing the {votes.length} most recent</span><a href="/votes">See all votes →</a></p>
        </section>

        <section class="tab-pane" id="laws">
          <header class="pane-head">
            <h2>Recently signed into law</h2>
            <p>{overview?.laws ?? 0} bills have become law this Congress. These are the newest.</p>
          </header>
          <ol class="reclist">
            {
              laws.map((b) => (
                <li>
                  <a href={`/bills/${b.id}`}>
                    <span class="tag">{billNumber(b.bill_type, b.number)}</span>
                    <span class="rl-title">{b.title}</span>
                    <span class="rl-meta"><span>Signed {consoleDate(b.status_date)}</span></span>
                  </a>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="tab-pane" id="new">
          <header class="pane-head">
            <h2>Just introduced</h2>
            <p>{week?.introduced ?? 0} new bills and resolutions this week. The newest, with the most cosponsors first:</p>
          </header>
          {
            introduced.length ? (
              <ol class="reclist">
                {introduced.map((b) => (
                  <li>
                    <a href={`/bills/${b.id}`}>
                      <span class="tag">{billNumber(b.bill_type, b.number)}</span>
                      <span class="rl-title">{b.title}</span>
                      <span class="rl-meta">
                        {b.sponsor_name && (
                          <span>
                            {lastName(b.sponsor_name)} <span class={`party ${partyClass(b.sponsor_party)}`}>{b.sponsor_party}-{b.sponsor_state}</span>
                          </span>
                        )}
                        <span>{consoleDate(b.introduced_date)}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="empty">No new bills this week</p>
            )
          }
        </section>
      </div>
    </Panel>

    <div class="cols cols-main-side">
      <Panel label="Browse bills by topic">
        <div class="panel-body topics">
          {
            (topics ?? []).slice(0, 15).map((t) => (
              <a class="topic" href={`/topics/${t.slug}`}>
                <span>{t.area}</span>
                <span class="label">{t.bills.toLocaleString("en-US")}</span>
              </a>
            ))
          }
          <a class="topic all" href="/topics"><span>All topics</span><span class="label">→</span></a>
        </div>
      </Panel>

      <Panel label="This Congress so far">
        <div class="panel-body so-far">
          <div class="boxes">
            <div class="statbox"><div class="label">Bills and resolutions</div><div class="value" data-count={overview?.bills ?? 0}>{(overview?.bills ?? 0).toLocaleString("en-US")}</div></div>
            <div class="statbox"><div class="label">Became law</div><div class="value ok" data-count={overview?.laws ?? 0}>{overview?.laws ?? 0}</div></div>
            <div class="statbox"><div class="label">Recorded votes</div><div class="value" data-count={overview?.votes ?? 0}>{(overview?.votes ?? 0).toLocaleString("en-US")}</div></div>
            <div class="statbox"><div class="label">Votes that passed</div><div class="value" data-count={overview?.vote_pass_pct ?? 0} data-decimals="1" data-suffix="%">{overview?.vote_pass_pct ?? 0}%</div></div>
          </div>
          <div class="agg">
            <div class="agg-head">
              <span class="label">Yes votes cast by members</span>
              <span class="agg-num" data-count={overview?.yea_total ?? 0}>{(overview?.yea_total ?? 0).toLocaleString("en-US")}</span>
            </div>
            <SegBar value={overview?.yea_total ?? 0} max={yeaMax} cells={28} tone="bright" label="Total yes votes cast this Congress" />
          </div>
          <div class="agg">
            <div class="agg-head">
              <span class="label">No votes cast by members</span>
              <span class="agg-num dimnum" data-count={overview?.nay_total ?? 0}>{(overview?.nay_total ?? 0).toLocaleString("en-US")}</span>
            </div>
            <SegBar value={overview?.nay_total ?? 0} max={yeaMax} cells={28} tone="dim" label="Total no votes cast this Congress" />
          </div>
          <a class="more" href="/analytics">See trends and charts →</a>
        </div>
      </Panel>
    </div>
  </div>
</Layout>

<style>
  .console > * + * {
    margin-top: var(--gap);
  }
  .hero-body {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: end;
    gap: 28px 48px;
    padding: clamp(20px, 3vw, 40px);
  }
  h1 {
    margin: 12px 0 18px;
    font-size: clamp(2.4rem, 1.5rem + 3vw, 4.6rem);
  }
  .intro {
    max-width: 52ch;
    margin: 0;
    padding: 2px 0 2px 16px;
    border-left: 1px solid var(--line-2);
    color: #c4c4c4;
    font-size: 1rem;
  }
  .week {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .week-box {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 104px;
    padding: 16px 18px;
    transition:
      border-color 120ms ease,
      background 120ms ease;
  }
  .week-box .value {
    margin: auto 0 0;
    font-size: clamp(1.8rem, 1.4rem + 1.2vw, 2.6rem);
    font-weight: 300;
  }
  .go-hint {
    position: absolute;
    right: 16px;
    bottom: 14px;
    font-family: var(--mono);
    color: var(--faint);
    transition:
      color 120ms ease,
      transform 160ms var(--ease);
  }
  .week-box:hover {
    border-color: var(--muted);
    background: var(--raise);
  }
  .week-box:hover .go-hint {
    color: var(--bright);
    transform: translateX(3px);
  }

  /* Search sits in the dark page like the rest: an inset field with one bright button.
     Wide screens put the label beside the field so the panel stays two rows tall. */
  .cmd {
    display: grid;
    grid-template-areas: "label" "line" "quick";
    gap: 12px;
    padding: clamp(16px, 2vw, 24px);
  }
  .cmd-label {
    grid-area: label;
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.4rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--bright);
  }
  /* The field itself is styled in global.css (shared with Search and Find my rep). */
  .cmd-line {
    grid-area: line;
  }
  .quick {
    grid-area: quick;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .quick a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line-2);
    font: 500 0.94rem var(--font);
    color: var(--soft);
    transition:
      background 120ms ease,
      border-color 120ms ease,
      color 120ms ease;
  }
  .quick a:hover {
    background: var(--panel-2);
    border-color: var(--muted);
    color: var(--text);
  }
  @media (min-width: 900px) {
    .cmd {
      grid-template-columns: max-content minmax(0, 1fr);
      grid-template-areas: "label line" "quick quick";
      align-items: center;
      column-gap: 24px;
    }
  }

  .topics {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 0 22px;
  }
  .topic {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 46px;
    padding: 10px 8px;
    border-bottom: 1px solid var(--line);
    font-size: 0.94rem;
    color: #c8c8c8;
    transition: background 100ms ease;
  }
  .topic:hover {
    color: var(--bright);
    background: var(--raise);
    border-bottom-color: var(--muted);
  }
  .topic.all {
    color: var(--bright);
  }
  .so-far {
    display: grid;
    gap: 20px;
  }
  .boxes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .agg-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    margin-bottom: 10px;
  }
  .agg-num {
    font: 300 clamp(1.3rem, 1.1rem + 0.6vw, 1.7rem)/1 var(--mono);
    letter-spacing: -0.02em;
    color: var(--bright);
    font-variant-numeric: tabular-nums;
  }
  .agg-num.dimnum {
    color: var(--muted);
  }
  .more {
    justify-self: start;
    padding: 6px 0;
    font: 500 var(--fs-sm) var(--font);
    color: var(--bright);
  }
  .more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 960px) {
    .hero-body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    /* Phones list the eight biggest topics; "All topics" leads to the rest. */
    .topic:nth-child(n + 9):not(.all) {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .week-box {
      min-height: 92px;
      padding: 12px 14px;
    }
    /* Phones: the four shortcuts sit two by two so the search panel stays short. */
    .quick {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .quick a {
      display: flex;
      justify-content: space-between;
      height: 100%;
      min-height: 44px;
      padding: 8px 12px;
      font-size: 0.875rem;
      line-height: 1.3;
    }
  }
</style>
