---
import Panel from "../components/Panel.astro";
import Terminal from "../components/Terminal.astro";
import Layout from "../layouts/Layout.astro";

Astro.response.status = 404;
---

<Layout title="Page not found" crumbs={[{ label: "Page not found" }]}>
  <div class="console">
    <div class="cols cols-main-side">
      <Panel>
        <div class="panel-body lost">
          <p class="label alert"><span data-scramble>Nothing at this address</span></p>
          <h1 class="cursor"><span data-scramble>Page not found</span></h1>
          <p class="intro">This page doesn't exist, or its record hasn't been added yet. Try searching, or start from one of these:</p>
          <form class="cmd-line find" action="/search" role="search">
            <span aria-hidden="true">&gt;</span>
            <input type="search" name="q" placeholder="Try H.R. 1 or veterans" aria-label="Search bills, members, and topics" />
            <button class="go" type="submit">Search</button>
          </form>
          <div class="links">
            <a class="btn ghost" href="/">Home</a>
            <a class="btn ghost" href="/topics">Topics</a>
            <a class="btn ghost" href="/votes">Votes</a>
            <a class="btn ghost" href="/members">Members</a>
            <a class="btn ghost" href="/find">Find my rep</a>
          </div>
        </div>
      </Panel>
      <Panel label="What happened">
        <Terminal lines={[{ text: `You asked for ${Astro.url.pathname}` }, { text: "No page or record has that address", tone: "alert" }, { text: "The link may have a typo, or the page may have moved", tone: "bright" }]} />
      </Panel>
    </div>
  </div>
</Layout>

<style>
  .lost {
    padding: clamp(22px, 3vw, 40px);
  }
  h1 {
    margin: 10px 0 14px;
  }
  .intro {
    max-width: 60ch;
    color: #bdbdbd;
  }
  .find {
    max-width: 560px;
    margin-top: 18px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
</style>
