---
import Panel from "../../components/Panel.astro";
import TopicCard from "../../components/TopicCard.astro";
import Layout from "../../layouts/Layout.astro";
import { stat, type Topic } from "../../lib/db";

const topics = (await stat<Topic[]>("topics")) ?? [];
---

<Layout title="Topics" crumbs={[{ label: "Topics" }]}>
  <div class="console">
    <Panel>
      <div class="panel-body head">
        <h1 class="cursor"><span data-scramble>Browse bills by topic</span></h1>
        <p class="intro">Every bill is filed under one of these {topics.length} areas.</p>
      </div>
    </Panel>

    <ul class="grid">
      {
        topics.map((t) => (
          <li>
            <TopicCard topic={t} laws />
          </li>
        ))
      }
    </ul>
  </div>
</Layout>

<style>
  .head h1 {
    margin: 0 0 10px;
  }
  .intro {
    margin: 0;
    color: var(--soft);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 12px;
    margin: var(--gap) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 520px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
  }
</style>
