---
import Panel from "../components/Panel.astro";
import StatusTag from "../components/StatusTag.astro";
import Layout from "../layouts/Layout.astro";
import { BILL_LIST_COLUMNS, BILL_LIST_JOIN, row, rows, type BillListItem } from "../lib/db";
import { billNumber, consoleDate, CONGRESS, memberTag, partyClass } from "../lib/format";

const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 120);

// A bill number ("hr 1", "H.R.1", "s. 5", "hjres 12") goes straight to that bill.
const ref = q.toUpperCase().replace(/[\s.]/g, "").match(/^(HR|S|HJRES|SJRES|HCONRES|SCONRES|HRES|SRES)(\d+)$/);
if (ref) {
  const id = `${CONGRESS}-${ref[1].toLowerCase()}-${Number(ref[2])}`;
  if (await row("SELECT 1 FROM bills WHERE id = ?", id)) return Astro.redirect(`/bills/${id}`);
}

// Full-text search over bill titles: every word must match; the last may be a prefix.
const words = q.split(/\s+/).map((w) => w.replace(/["*^():{}\[\]-]/g, "")).filter((w) => w.length > 0).slice(0, 8);
const match = words.map((w, i) => (i === words.length - 1 && w.length > 2 ? `"${w}"*` : `"${w}"`)).join(" ");

const [bills, members] = q
  ? await Promise.all([
      match
        ? rows<BillListItem>(
            `SELECT ${BILL_LIST_COLUMNS} FROM bills_fts f JOIN bills b ON b.rowid = f.rowid ${BILL_LIST_JOIN}
              WHERE bills_fts MATCH ? ORDER BY rank LIMIT 40`,
            match,
          ).catch(() => [] as BillListItem[])
        : [],
      rows<{ bioguide_id: string; full_name: string; party: string | null; state: string | null; district: number | null; chamber: string | null; in_office: number; photo_url: string | null }>(
        `SELECT bioguide_id, full_name, party, state, district, chamber, in_office, photo_url FROM members
          WHERE full_name LIKE ? ORDER BY in_office DESC, last_name LIMIT 12`,
        `%${q}%`,
      ),
    ])
  : [[], []];
---

<Layout title={q ? `Search: ${q}` : "Search"} crumbs={["Search", q ? `"${q}"` : "Query"]}>
  <div class="console">
    <Panel invert class="cmd-panel">
      <form class="panel-body cmd" action="/search" role="search">
        <label class="label" for="search-q">Command input // Search bills and members</label>
        <div class="cmd-line">
          <span>&gt; search</span>
          <input id="search-q" name="q" type="search" value={q} placeholder="topic, bill title, H.R. 1, or member name" autocomplete="off" autofocus />
          <button class="go" type="submit">Enter</button>
        </div>
      </form>
    </Panel>

    {
      q && (
        <div class="cols cols-main-side results">
          <Panel label="Measures" code={`${bills.length} MATCH${bills.length === 1 ? "" : "ES"}`}>
            {bills.length ? (
              <div class="table-scroll">
                <table class="rtable">
                  <thead><tr><th>Measure</th><th>Subject</th><th>Status</th><th>Last action</th></tr></thead>
                  <tbody>
                    {bills.map((b) => (
                      <tr data-href={`/bills/${b.id}`}>
                        <td><a class="tag" href={`/bills/${b.id}`}>{billNumber(b.bill_type, b.number)}</a></td>
                        <td class="subject">{b.title}</td>
                        <td><StatusTag status={b.status} /></td>
                        <td class="mono">{consoleDate(b.latest_action_date)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p class="empty">No measures match “{q}”</p>
            )}
          </Panel>

          <Panel label="Members" code={`${members.length}`}>
            {members.length ? (
              <ul class="people">
                {members.map((m) => (
                  <li>
                    <a href={`/members/${m.bioguide_id}`}>
                      <span class="thumb">{m.photo_url && <img src={m.photo_url} alt="" loading="lazy" />}</span>
                      <span>
                        <span class="pname">{m.full_name}</span>
                        <span class={`party ${partyClass(m.party)}`}>{memberTag(m)}</span>
                        {!m.in_office && <span class="label faint"> · former</span>}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="empty">No members match</p>
            )}
          </Panel>
        </div>
      )
    }
  </div>
</Layout>

<style>
  .cmd {
    padding: clamp(20px, 3vw, 34px);
  }
  .cmd-line {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 16px;
    font: 500 clamp(1.1rem, 0.9rem + 1vw, 1.8rem) var(--mono);
    border-bottom: 1px solid #c4c4c4;
  }
  .cmd-line > span {
    white-space: nowrap;
  }
  .cmd-line input {
    flex: 1;
    min-width: 0;
    border: 0;
    padding: 14px 0;
    background: transparent;
    color: #050505;
    font: inherit;
  }
  .cmd-line input::placeholder {
    color: #a0a0a0;
  }
  .cmd-line input:focus-visible {
    outline: none;
  }
  .go {
    border: 1px solid #050505;
    background: #050505;
    color: #ececec;
    font: 500 0.66rem var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 9px 14px;
    cursor: pointer;
  }
  .go:hover {
    background: transparent;
    color: #050505;
  }
  .results {
    margin-top: var(--gap);
  }
  .people {
    list-style: none;
    margin: 0;
    padding: 6px var(--pad);
  }
  .people a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
  }
  .thumb {
    width: 32px;
    height: 39px;
    flex: none;
    background: #0c0c0c;
    border: 1px solid var(--line-2);
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }
  .pname {
    display: block;
    color: var(--bright);
  }
</style>
